{
  "name": "firefly",
  "workers_dev": true,
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/admin",
      "/api/admin/*",
      "/api/auth/*"
    ],
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "FIREFLY_SESSIONS"
    }
  ],
  "previews": {
    "kv_namespaces": [
      {
        "binding": "FIREFLY_SESSIONS",
        "id": "d2577742cfde47719ec224ba3ad57446"
      },
      {
        "binding": "SESSION",
        "id": "58d75098ced44eea98ec20fb46fe006c"
      }
    ]
  },
  "main": "@astrojs/cloudflare/entrypoints/server"
}
