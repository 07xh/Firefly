{
  "name": "firefly",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/admin",
      "/api/admin/*",
      "/api/auth/*"
    ],
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "FIREFLY_SESSIONS"
    }
  ],
  "previews": {},
  "main": "./dist/_worker.js/index.js"
}
