---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import { getSortedPostsList } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

// This is the same published-post source used by the article directory.
// Keep archive query links (?tag=, ?category=, ?uncategorized=) compatible.
const posts = (await getSortedPostsList())
	.slice()
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.published.getFullYear();
	if (!years.has(year)) years.set(year, []);
	years.get(year)?.push(post);
}
const groups = [...years.entries()]
	.map(([year, items]) => ({ year, items }))
	.sort((a, b) => b.year - a.year);
const foldOlderYears = siteConfig.foldArticle !== false && groups.length > 1;
---

<archive-panel class="space-archive" data-fold-older={String(foldOlderYears)}>
	<div class="space-archive-toolbar">
		<label class="space-archive-search">
			<Icon name="material-symbols:search-rounded" aria-hidden="true" />
			<span class="sr-only">在归档中搜索文章</span>
			<input data-archive-search type="search" autocomplete="off" placeholder="按标题、分类或标签查找" />
		</label>
		<a href={url("/posts/")} class="space-taxonomy-inline-link">
			文章列表 <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
		</a>
	</div>
	<div class="space-archive-info">
		<div>
			<strong data-archive-count>{posts.length} 篇文章</strong>
			<p data-archive-filter-label>按发布时间从近到远排列</p>
		</div>
		<a href={url("/archive/")} data-archive-reset hidden>清除筛选</a>
	</div>
	<div class="space-archive-years">
		{groups.map(({ year, items }, index) => (
			<details
				class="space-archive-year"
				data-year={String(year)}
				open={!foldOlderYears || index === 0}
			>
				<summary>
					<span class="space-archive-year-label">{year}</span>
					<span class="space-archive-year-total"><span data-year-count>{items.length}</span> 篇</span>
					<Icon name="material-symbols:keyboard-arrow-down-rounded" aria-hidden="true" />
				</summary>
				<ol class="space-archive-entries">
					{items.map(({ id, data }) => (
						<li
							data-archive-item
							data-archive-category={(data.category || "").trim()}
							data-archive-tags={JSON.stringify(data.tags || [])}
							data-archive-search-text={[
								data.title,
								data.description,
								data.category,
								data.series,
								...(data.tags || []),
							].filter(Boolean).join(" ").toLocaleLowerCase()}
						>
							<a href={getPostUrlBySlug(id)}>
								<time datetime={data.published.toISOString()}>{formatDateToYYYYMMDD(data.published).slice(5)}</time>
								<span class="space-archive-item-main">
									<strong>{data.title}</strong>
									{data.category && <small>{data.category}</small>}
								</span>
								<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
							</a>
						</li>
					))}
				</ol>
			</details>
		))}
	</div>
	<div class="space-taxonomy-empty" data-archive-empty hidden>
		<p>没有符合条件的文章。</p>
		<a href={url("/archive/")}>查看全部归档</a>
	</div>
</archive-panel>

<script>
	class SpaceArchivePanel extends HTMLElement {
		private tags: string[] = [];
		private categories: string[] = [];
		private uncategorized = false;

		connectedCallback() {
			const params = new URLSearchParams(window.location.search);
			this.tags = params.getAll("tag");
			this.categories = params.getAll("category");
			this.uncategorized = Boolean(params.get("uncategorized"));
			const search = this.querySelector<HTMLInputElement>("[data-archive-search]");
			if (search) search.value = params.get("q") ?? "";
			this.addEventListener("input", this.handleInput);
			this.update();
		}

		disconnectedCallback() {
			this.removeEventListener("input", this.handleInput);
		}

		private handleInput = (event: Event) => {
			if (!(event.target instanceof Element) || !event.target.matches("[data-archive-search]")) return;
			this.update(true);
		};

		private update(updateUrl = false) {
			const query = this.querySelector<HTMLInputElement>("[data-archive-search]")?.value.trim().toLocaleLowerCase() ?? "";
			const filtered = Boolean(query || this.tags.length || this.categories.length || this.uncategorized);
			let total = 0;
			let visibleGroups = 0;

			this.querySelectorAll<HTMLDetailsElement>(".space-archive-year").forEach((group) => {
				let count = 0;
				group.querySelectorAll<HTMLElement>("[data-archive-item]").forEach((item) => {
					let itemTags: string[] = [];
					try {
						itemTags = JSON.parse(item.dataset.archiveTags ?? "[]") as string[];
					} catch {
						itemTags = [];
					}
					const category = item.dataset.archiveCategory ?? "";
					const matchesTags = !this.tags.length || itemTags.some((tag) => this.tags.includes(tag));
					const matchesCategories = !this.categories.length || this.categories.includes(category);
					const matchesUncategorized = !this.uncategorized || !category;
					const matchesQuery = !query || (item.dataset.archiveSearchText ?? "").includes(query);
					const matches = matchesTags && matchesCategories && matchesUncategorized && matchesQuery;
					item.hidden = !matches;
					if (matches) count++;
				});
				group.hidden = count === 0;
				const countElement = group.querySelector<HTMLElement>("[data-year-count]");
				if (countElement) countElement.textContent = String(count);
				if (count) {
					total += count;
					if (filtered) group.open = true;
					else group.open = !this.dataset.foldOlder || this.dataset.foldOlder === "false" || visibleGroups === 0;
					visibleGroups++;
				}
			});
			const countElement = this.querySelector<HTMLElement>("[data-archive-count]");
			if (countElement) countElement.textContent = `${total} 篇文章`;
			const summary = this.querySelector<HTMLElement>("[data-archive-filter-label]");
			if (summary) {
				const parts = [
					...this.tags.map((tag) => `#${tag}`),
					...this.categories.map((category) => `分类：${category}`),
					...(this.uncategorized ? ["未分类"] : []),
					...(query ? [`搜索：${query}`] : []),
				];
				summary.textContent = parts.length ? parts.join(" · ") : "按发布时间从近到远排列";
			}
			const reset = this.querySelector<HTMLElement>("[data-archive-reset]");
			if (reset) reset.hidden = !filtered;
			const empty = this.querySelector<HTMLElement>("[data-archive-empty]");
			if (empty) empty.hidden = total !== 0;
			if (updateUrl) {
				const target = new URL(window.location.href);
				if (query) target.searchParams.set("q", query);
				else target.searchParams.delete("q");
				window.history.replaceState(window.history.state, "", target);
			}
		}
	}
	if (!customElements.get("archive-panel")) customElements.define("archive-panel", SpaceArchivePanel);
</script>
