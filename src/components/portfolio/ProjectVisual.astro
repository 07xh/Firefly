---
import type { CollectionEntry } from "astro:content";
import CoverImage from "@/components/common/CoverImage.astro";
import { getFileDirFromPath } from "@/utils/url-utils";

interface Props {
	project: CollectionEntry<"projects">;
	priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { title, image } = project.data;
---

{image && (
	<CoverImage
		src={image}
		basePath={getFileDirFromPath(project.filePath || "")}
		alt={`${title}界面`}
		class="portfolio-project-screenshot"
		preview={false}
		loading={priority ? "eager" : "lazy"}
		naturalHeight
	/>
)}
