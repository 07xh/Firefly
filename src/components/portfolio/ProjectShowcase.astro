---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import ProjectVisual from "@/components/portfolio/ProjectVisual.astro";
import { getProjectStatusMeta, resolveProjectImage } from "@/utils/projects-utils";
import { url } from "@/utils/url-utils";

interface NavigationProject {
	slug: string;
	title: string;
}

interface Props {
	entry: CollectionEntry<"projects">;
	position: number;
	total: number;
	previous: NavigationProject | null;
	next: NavigationProject | null;
}

const { entry, previous, next, position, total } = Astro.props;
const { Content } = await render(entry);
const { title, subtitle, description, link, status, tags } = entry.data;
const statusLabel = getProjectStatusMeta(status || "").label;
const zoomImage = await resolveProjectImage(entry.data.image, entry.filePath);
---

<project-page class="portfolio-project-page space-showcase-page">
		<nav class="space-project-switch" aria-label="切换展示项目">
			{previous && (
				<a
					class="space-project-arrow space-project-arrow-previous"
					href={url("/projects/" + previous.slug + "/")}
					data-previous
					rel="prev"
					aria-label={"上一个项目：" + previous.title}
					title={"上一个项目：" + previous.title}
				>
					<Icon name="material-symbols:arrow-back-rounded" aria-hidden="true" />
					<span class="space-project-arrow-label">{previous.title}</span>
				</a>
			)}
			{next && (
				<a
					class="space-project-arrow space-project-arrow-next"
					href={url("/projects/" + next.slug + "/")}
					data-next
					rel="next"
					aria-label={"下一个项目：" + next.title}
					title={"下一个项目：" + next.title}
				>
					<span class="space-project-arrow-label">{next.title}</span>
					<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
				</a>
			)}
		</nav>

		<header class="space-project-hero" aria-labelledby="project-title">
			<div class="space-project-copy">
				<div class="space-project-overline">
					<span class="space-project-counter">{String(position).padStart(2, "0")} <span aria-hidden="true">/</span> {String(total).padStart(2, "0")}</span>
					<span class="space-project-overline-divider" aria-hidden="true"></span>
					<span>作品展示</span>
				</div>
				{subtitle && <p class="space-project-subtitle">{subtitle}</p>}
				<h1 id="project-title" data-pagefind-meta="title">{title}</h1>
				{description && <p class="space-project-description">{description}</p>}
				<div class="space-project-meta" aria-label="项目状态与技术方向">
					{statusLabel && <span class="space-project-status"><span aria-hidden="true"></span>{statusLabel}</span>}
					{tags.slice(0, 3).map((tag) => <span class="space-project-tag">{tag}</span>)}
				</div>
				{link.length > 0 && (
					<div class="portfolio-actions space-project-actions">
						{link.map(({ label, value }, index) => (
							<a
								id={label === "GitHub" ? "project-repository" : undefined}
								href={value}
								class:list={["portfolio-button", index === 0 ? "portfolio-button-solid" : "portfolio-button-secondary"]}
							>
								{label === "GitHub" && <Icon name="fa7-brands:github" aria-hidden="true" />}
								<span>{label}</span>
								<Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
							</a>
						))}
					</div>
				)}
				<a class="space-project-scroll-cue" href="#project-details">
					<Icon name="material-symbols:arrow-downward-rounded" aria-hidden="true" />
					向下阅读项目详情
				</a>
			</div>

			<figure class:list={["space-project-stage", { "space-project-stage-empty": !entry.data.image }]}>
				<div class="space-project-stage-top">
					<span class="space-project-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="space-project-stage-name">{subtitle || title}</span>
					<span class="space-project-stage-kind">{entry.data.image ? "界面预览" : "项目展示"}</span>
				</div>
				<div class="space-project-stage-body">
					{entry.data.image ? (
						<div class="space-project-image-wrap">
							<ProjectVisual project={entry} priority />
							{zoomImage && (
								<a class="space-project-image-expand" href={zoomImage} data-fancybox="project-cover" data-type="image" aria-label={"放大查看" + title + "截图"}>
									<Icon name="material-symbols:open-in-full-rounded" aria-hidden="true" />
								</a>
							)}
						</div>
					) : (
						<div class="space-project-placeholder" aria-label="该项目暂未提供界面截图">
							<span class="space-project-placeholder-index">07xh / PROJECT</span>
							<strong>{title}</strong>
							<span class="space-project-placeholder-subtitle">{subtitle || "软件项目"}</span>
							<span class="space-project-placeholder-note">界面截图待补充</span>
						</div>
					)}
				</div>
			</figure>
			<div class="space-project-hero-bottom" aria-label="项目浏览方式">
				<span>← → 切换项目</span>
				<a href={url("/projects/all/")}>查看全部项目 <Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" /></a>
			</div>
		</header>

		<section class="portfolio-detail-body space-project-details" id="project-details" aria-label={title + "项目详情"}>
			<div class="space-project-details-heading">
				<span>项目详情</span>
				<h2>{title}</h2>
			</div>
			<div data-pagefind-body>
				<Markdown class="markdown-content"><Content /></Markdown>
			</div>
		</section>
	</project-page>

<script>
	class ProjectPage extends HTMLElement {
		private gesture: { id: number; x: number; y: number } | null = null;
		private wheelDistance = 0;
		private wheelTime = 0;
		private navigating = false;

		connectedCallback() {
			this.addEventListener("pointerdown", this.start);
			this.addEventListener("pointerup", this.end);
			this.addEventListener("pointercancel", this.cancel);
			this.addEventListener("wheel", this.onWheel, { passive: false });
			document.addEventListener("keydown", this.onKey);
			window.addEventListener("pageshow", this.resetNavigation);
		}

		disconnectedCallback() {
			this.removeEventListener("pointerdown", this.start);
			this.removeEventListener("pointerup", this.end);
			this.removeEventListener("pointercancel", this.cancel);
			this.removeEventListener("wheel", this.onWheel);
			document.removeEventListener("keydown", this.onKey);
			window.removeEventListener("pageshow", this.resetNavigation);
		}

		private readonly interactive = "a,button,input,select,textarea,summary,[contenteditable],[role=dialog],pre,table";
		private canMove(event: Event) {
			return !(event.target instanceof Element && event.target.closest(this.interactive));
		}

		private move(forward: boolean) {
			const link = this.querySelector<HTMLAnchorElement>(forward ? "[data-next]" : "[data-previous]");
			if (!link) return false;
			if (!this.navigating) {
				this.navigating = true;
				window.location.assign(link.href);
			}
			return true;
		}

		private start = (event: PointerEvent) => {
			if (!event.isPrimary || event.pointerType === "mouse" || !this.canMove(event)) return;
			this.gesture = { id: event.pointerId, x: event.clientX, y: event.clientY };
		};

		private end = (event: PointerEvent) => {
			const start = this.gesture;
			this.cancel();
			if (!start || start.id !== event.pointerId) return;
			const dx = event.clientX - start.x;
			const dy = event.clientY - start.y;
			if (Math.abs(dx) > 65 && Math.abs(dx) > Math.abs(dy) * 1.6) this.move(dx < 0);
		};

		private cancel = () => { this.gesture = null; };

		private resetNavigation = () => { this.navigating = false; this.wheelDistance = 0; };

		private onWheel = (event: WheelEvent) => {
			if (event.ctrlKey || !this.canMove(event) || Math.abs(event.deltaX) < Math.abs(event.deltaY) * 1.6 || !event.deltaX) return;
			if (event.timeStamp - this.wheelTime > 180 || this.wheelDistance * event.deltaX < 0) this.wheelDistance = 0;
			this.wheelTime = event.timeStamp;
			this.wheelDistance += event.deltaX * (event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : 1);
			if (Math.abs(this.wheelDistance) > 90 && this.move(this.wheelDistance > 0)) event.preventDefault();
		};

		private onKey = (event: KeyboardEvent) => {
			if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || !this.canMove(event) || window.getSelection()?.toString()) return;
			if ((event.key === "ArrowLeft" || event.key === "ArrowRight") && this.move(event.key === "ArrowRight")) event.preventDefault();
		};
	}

	if (!customElements.get("project-page")) customElements.define("project-page", ProjectPage);
</script>
