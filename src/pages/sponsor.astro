---
import Comment from "@components/comment/index.astro";
import { Icon } from "astro-icon/components";
import { commentConfig, siteConfig, sponsorConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/space-utility.css";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.sponsor) return Astro.redirect("/404/");

const title = sponsorConfig.title || i18n(I18nKey.sponsorTitle);
const description = sponsorConfig.description || i18n(I18nKey.sponsorDescription);
const methods = sponsorConfig.methods.filter((method) => method.enabled);
const commentsEnabled = commentConfig.type !== "none" && sponsorConfig.showComment !== false;
---

<PortfolioLayout title={title} description={description}>
	<section class="space-utility-page space-sponsor-page">
		<header class="space-utility-heading">
			<div>
				<h1>{title}</h1>
				<p>{description}</p>
			</div>
		</header>
		{sponsorConfig.usage && <p class="space-sponsor-note">{sponsorConfig.usage}</p>}
		{methods.length > 0 ? (
			<div class="space-sponsor-methods">
				{methods.map((method) => (
					<section class="space-sponsor-method">
						<div class="space-sponsor-method-heading">
							{method.icon && <Icon name={method.icon} aria-hidden="true" />}
							<h2>{method.name}</h2>
						</div>
						{method.description && <p>{method.description}</p>}
						{method.qrCode && (
							<img src={url(method.qrCode)} alt={`${method.name} 收款二维码`} loading="lazy" width="190" height="190" />
						)}
						{method.link && (
							<a href={method.link} target="_blank" rel="noopener noreferrer">
								打开支持页面 <Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
							</a>
						)}
					</section>
				))}
			</div>
		) : (
			<div class="space-sponsor-unavailable">
				<Icon name="material-symbols:info-outline-rounded" aria-hidden="true" />
				<div>
					<h2>暂未配置支持方式</h2>
					<p>原主题的示例收款地址已停用，本站目前没有可以使用的收款渠道。</p>
				</div>
			</div>
		)}
		{sponsorConfig.showSponsorsList !== false && sponsorConfig.sponsors.length > 0 && (
			<section class="space-sponsor-supporters">
				<h2>{i18n(I18nKey.sponsorList)}</h2>
				<div class="space-sponsor-supporter-grid">
					{sponsorConfig.sponsors.map((sponsor) => (
						<div class="space-sponsor-supporter">
							<span class="space-sponsor-supporter-avatar">
								{sponsor.avatar ? <img src={url(sponsor.avatar)} alt="" loading="lazy" /> : sponsor.name.charAt(0)}
							</span>
							<span>
								<strong>{sponsor.name}</strong>
								{sponsor.date && <small>{sponsor.date}</small>}
							</span>
							{sponsor.amount && <span>{sponsor.amount}</span>}
						</div>
					))}
				</div>
			</section>
		)}
		{commentsEnabled && <section class="space-utility-comments"><Comment customPath="/sponsor/" title="sponsor" /></section>}
	</section>
</PortfolioLayout>
