---
import { Icon } from "astro-icon/components";
import EncryptedContent from "@/components/features/EncryptedContent.astro";
import PhotoCard from "@/components/pages/gallery/PhotoCard.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/pages/gallery-album.css";
import "@/styles/space-utility.css";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";

export const prerender = true;

if (!siteConfig.pages.gallery) return Astro.redirect("/404/");

export function getStaticPaths() {
	return galleryConfig.albums.map((album) => ({ params: { album: album.id } }));
}

const { album: albumId } = Astro.params;
const albumMeta = galleryConfig.albums.find((item) => item.id === albumId);
if (!albumMeta) return Astro.redirect("/404/");
const photos = scanAlbumPhotos(albumMeta.id);
const cover = getAlbumCover(albumMeta, photos);
const columnWidth = galleryConfig.columnWidth || 240;
const demo = albumMeta.id === "firefly-2026" || albumMeta.id === "encrypted-test";
---

<PortfolioLayout title={albumMeta.name} description={albumMeta.description || ""}>
	<article class="space-utility-page space-gallery-detail">
		<a href={url("/gallery/")} class="space-utility-back">
			<Icon name="material-symbols:arrow-back-rounded" aria-hidden="true" />
			返回全部相册
		</a>
		<header class="space-gallery-detail-heading">
			{demo && <span class="space-gallery-demo-chip">原主题示例相册</span>}
			<h1>{albumMeta.name}</h1>
			{albumMeta.description && <p>{albumMeta.description}</p>}
			<div class="space-gallery-detail-meta">
				{albumMeta.date && (
					<span><Icon name="material-symbols:calendar-today-rounded" aria-hidden="true" />{albumMeta.date}</span>
				)}
				{albumMeta.location && (
					<span><Icon name="material-symbols:location-on-outline-rounded" aria-hidden="true" />{albumMeta.location}</span>
				)}
				<span><Icon name="material-symbols:photo-library-outline-rounded" aria-hidden="true" />{photos.length} {i18n(I18nKey.galleryPhotos)}</span>
			</div>
			{(albumMeta.tags || []).length > 0 && (
				<div class="space-gallery-detail-tags">{(albumMeta.tags || []).map((tag) => <span>#{tag}</span>)}</div>
			)}
		</header>
		{cover && (
			<div class="space-gallery-detail-cover">
				<img src={cover} alt={albumMeta.name} width="1200" height="440" decoding="async" />
			</div>
		)}
		<section class="space-gallery-detail-photos" aria-label="相册照片">
			{photos.length > 0 ? (
				albumMeta.password ? (
					<EncryptedContent password={albumMeta.password} slug={albumMeta.id} hint={albumMeta.passwordHint}>
						<div class="gallery-masonry" style={`--col-width: ${columnWidth}px`}>
							{photos.map((photo) => <PhotoCard src={photo} albumId={albumMeta.id} />)}
						</div>
					</EncryptedContent>
				) : (
					<div class="gallery-masonry" style={`--col-width: ${columnWidth}px`}>
						{photos.map((photo) => <PhotoCard src={photo} albumId={albumMeta.id} />)}
					</div>
				)
			) : (
				<div class="space-utility-empty"><p>这个相册还没有照片。</p></div>
			)}
		</section>
	</article>
</PortfolioLayout>
