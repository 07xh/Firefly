---
import { Icon } from "astro-icon/components";
import AlbumCard from "@/components/pages/gallery/AlbumCard.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/space-utility.css";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";

if (!siteConfig.pages.gallery) return Astro.redirect("/404/");

const title = i18n(I18nKey.gallery);
const description = i18n(I18nKey.galleryDescription);
const albums = galleryConfig.albums.map((album) => {
	const photos = scanAlbumPhotos(album.id);
	return {
		...album,
		cover: getAlbumCover(album, photos),
		photoCount: photos.length,
	};
});
const allTags = [...new Set(albums.flatMap(({ tags }) => tags || []))].sort();
const demoIds = new Set(["firefly-2026", "encrypted-test"]);
---

<PortfolioLayout title={title} description={description}>
	<gallery-filter class="space-utility-page space-gallery-page">
		<header class="space-utility-heading">
			<div>
				<h1>{title}</h1>
				<p>{description}</p>
			</div>
			<span class="space-utility-caption">{albums.length} 个相册</span>
		</header>
		{albums.length > 0 ? (
			<>
				<label class="space-utility-search">
					<Icon name="material-symbols:search-rounded" aria-hidden="true" />
					<span class="sr-only">搜索相册标题、地点与标签</span>
					<input data-search type="search" autocomplete="off" placeholder="搜索相册、地点或标签" />
				</label>
				{allTags.length > 0 && (
					<nav class="space-utility-filters" aria-label="相册标签">
						<button type="button" data-tag="" aria-pressed="true">全部 <span>{albums.length}</span></button>
						{allTags.map((tag) => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
					</nav>
				)}
				<div class="space-utility-count-row">
					<span data-result-count aria-live="polite">共 {albums.length} 个相册</span>
					<button type="button" data-reset hidden>清除筛选</button>
				</div>
				<div class="space-gallery-grid">
					{albums.map((album) => (
						<div
							class="space-gallery-slot"
							data-album
							data-tags={JSON.stringify(album.tags || [])}
							data-search-text={[album.name, album.description, album.location, ...(album.tags || [])].filter(Boolean).join(" ").toLocaleLowerCase()}
						>
							{demoIds.has(album.id) && <span class="space-gallery-demo-label">原主题示例</span>}
							<AlbumCard
								id={album.id}
								name={album.name}
								description={album.description}
								cover={album.cover}
								date={album.date}
								location={album.location}
								tags={album.tags}
								photoCount={album.photoCount}
								encrypted={Boolean(album.password)}
							/>
						</div>
					))}
				</div>
				<div class="space-utility-empty" data-no-results hidden>
					<p>没有找到符合条件的相册。</p>
					<button type="button" data-reset>清除筛选</button>
				</div>
			</>
		) : (
			<div class="space-utility-empty"><p>{i18n(I18nKey.galleryNoAlbums)}</p></div>
		)}
	</gallery-filter>
</PortfolioLayout>

<script>
	class SpaceGalleryFilter extends HTMLElement {
		private tag = "";
		connectedCallback() {
			this.addEventListener("click", this.onClick);
			this.addEventListener("input", this.onInput);
			this.update();
		}
		disconnectedCallback() {
			this.removeEventListener("click", this.onClick);
			this.removeEventListener("input", this.onInput);
		}
		private onInput = (event: Event) => {
			if (event.target instanceof Element && event.target.matches("[data-search]")) this.update();
		};
		private onClick = (event: MouseEvent) => {
			if (!(event.target instanceof Element)) return;
			const tag = event.target.closest<HTMLButtonElement>("button[data-tag]");
			if (tag) this.tag = tag.dataset.tag ?? "";
			else if (event.target.closest("[data-reset]")) {
				this.tag = "";
				const input = this.querySelector<HTMLInputElement>("[data-search]");
				if (input) { input.value = ""; input.focus(); }
			} else return;
			this.update();
		};
		private update() {
			const query = this.querySelector<HTMLInputElement>("[data-search]")?.value.trim().toLocaleLowerCase() ?? "";
			let count = 0;
			this.querySelectorAll<HTMLElement>("[data-album]").forEach((album) => {
				let tags: string[] = [];
				try { tags = JSON.parse(album.dataset.tags ?? "[]") as string[]; } catch { tags = []; }
				const tagMatches = !this.tag || tags.includes(this.tag);
				const textMatches = !query || (album.dataset.searchText ?? "").includes(query);
				album.hidden = !(tagMatches && textMatches);
				if (!album.hidden) count++;
			});
			this.querySelectorAll<HTMLButtonElement>("button[data-tag]").forEach((button) => {
				button.setAttribute("aria-pressed", String((button.dataset.tag ?? "") === this.tag));
			});
			const total = this.querySelector<HTMLElement>("[data-result-count]");
			if (total) total.textContent = `找到 ${count} 个相册`;
			this.querySelectorAll<HTMLElement>("[data-reset]").forEach((button) => {
				button.hidden = !query && !this.tag;
			});
			const empty = this.querySelector<HTMLElement>("[data-no-results]");
			if (empty) empty.hidden = count !== 0;
		}
	}
	if (!customElements.get("gallery-filter")) customElements.define("gallery-filter", SpaceGalleryFilter);
</script>
