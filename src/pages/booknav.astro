---
import { Icon } from "astro-icon/components";
import { booknavPageConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/space-utility.css";
import {
	getBooknavDomain,
	getBooknavLetter,
	getEnabledBooknavGroups,
	resolveBooknavIcon,
} from "@/utils/booknav-utils";

if (!siteConfig.pages.booknav) return Astro.redirect("/404/");

const title = booknavPageConfig.title || i18n(I18nKey.booknav);
const description = booknavPageConfig.description || "开发时常用的网站和工具。";
const groups = getEnabledBooknavGroups().map((group) => ({
	...group,
	items: group.items.map((item) => ({
		...item,
		domain: getBooknavDomain(item.url),
		letter: getBooknavLetter(item.title),
		resolvedIcon: resolveBooknavIcon(item, booknavPageConfig.favicon),
	})),
}));
const total = groups.reduce((sum, group) => sum + group.items.length, 0);
---

<PortfolioLayout title={title} description={description}>
	<booknav-list class="space-utility-page space-link-directory">
		<header class="space-utility-heading">
			<div>
				<h1>{title}</h1>
				<p>{description}</p>
			</div>
			<span class="space-utility-caption">{total} 个网站</span>
		</header>
		{total > 0 ? (
			<>
				<label class="space-utility-search">
					<Icon name="material-symbols:search-rounded" aria-hidden="true" />
					<span class="sr-only">搜索网站名称、介绍或域名</span>
					<input type="search" data-search autocomplete="off" placeholder="搜索网站、功能或域名" />
				</label>
				<div class="space-link-groups-nav" role="navigation" aria-label="书签分类">
					{groups.map((group) => (
						<button type="button" data-group-target={group.id}>
							{group.name}<span>{group.items.length}</span>
						</button>
					))}
				</div>
				<p class="space-utility-result-count" data-result-count aria-live="polite">共 {total} 个网站</p>
				<div class="space-link-groups">
					{groups.map((group) => (
						<section class="space-link-group" id={group.id} data-group-id={group.id}>
							<header class="space-link-group-heading">
								<div>
									<h2>{group.name}</h2>
									{group.desc && <p>{group.desc}</p>}
								</div>
								<span><span data-group-count>{group.items.length}</span> 个</span>
							</header>
							<div class="space-link-grid">
								{group.items.map((item) => (
									<a
										class="space-link-card"
										href={item.url}
										target="_blank"
										rel="noopener noreferrer"
										data-bookmark
										data-search-text={[item.title, item.desc, item.domain, group.name].filter(Boolean).join(" ").toLocaleLowerCase()}
									>
										<span class="space-link-icon" data-letter={item.letter}>
											{item.resolvedIcon.kind === "icon" && <Icon name={item.resolvedIcon.value} />}
											{item.resolvedIcon.kind === "image" && (
												<img src={item.resolvedIcon.value} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
											)}
											{item.resolvedIcon.kind === "letter" && <span class="space-link-letter">{item.letter}</span>}
										</span>
										<span class="space-link-card-body">
											<strong>{item.title}</strong>
											<small>{item.desc || item.domain}</small>
											<span>{item.domain}</span>
										</span>
										<Icon name="material-symbols:arrow-outward-rounded" class="space-link-arrow" aria-hidden="true" />
									</a>
								))}
							</div>
						</section>
					))}
				</div>
				<div class="space-utility-empty" data-no-results hidden>
					<p>没有找到匹配的网站。</p>
					<button type="button" data-clear-search>清除搜索</button>
				</div>
			</>
		) : (
			<div class="space-utility-empty"><p>{i18n(I18nKey.booknavEmpty)}</p></div>
		)}
	</booknav-list>
</PortfolioLayout>

<script>
	class SpaceBookmarkList extends HTMLElement {
		connectedCallback() {
			this.addEventListener("input", this.onInput);
			this.addEventListener("click", this.onClick);
			this.addEventListener("error", this.onIconError, true);
			this.apply();
		}
		disconnectedCallback() {
			this.removeEventListener("input", this.onInput);
			this.removeEventListener("click", this.onClick);
			this.removeEventListener("error", this.onIconError, true);
		}
		private onInput = (event: Event) => {
			if (event.target instanceof Element && event.target.matches("[data-search]")) this.apply();
		};
		private onClick = (event: MouseEvent) => {
			if (!(event.target instanceof Element)) return;
			if (event.target.closest("[data-clear-search]")) {
				const input = this.querySelector<HTMLInputElement>("[data-search]");
				if (input) { input.value = ""; input.focus(); }
				this.apply();
			}
			const jump = event.target.closest<HTMLButtonElement>("[data-group-target]");
			const group = jump?.dataset.groupTarget
				? [...this.querySelectorAll<HTMLElement>("[data-group-id]")].find((item) => item.dataset.groupId === jump.dataset.groupTarget)
				: null;
			if (!group) return;
			group.scrollIntoView({ block: "start", behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
		};
		private onIconError = (event: Event) => {
			const target = event.target;
			if (!(target instanceof HTMLImageElement)) return;
			const parent = target.closest<HTMLElement>(".space-link-icon");
			if (!parent || parent.dataset.fallback === "true") return;
			parent.dataset.fallback = "true";
			target.remove();
			const label = document.createElement("span");
			label.className = "space-link-letter";
			label.textContent = parent.dataset.letter || "?";
			parent.append(label);
		};
		private apply() {
			const query = this.querySelector<HTMLInputElement>("[data-search]")?.value.trim().toLocaleLowerCase() ?? "";
			let visible = 0;
			this.querySelectorAll<HTMLElement>("[data-group-id]").forEach((group) => {
				let count = 0;
				group.querySelectorAll<HTMLElement>("[data-bookmark]").forEach((card) => {
					card.hidden = Boolean(query && !(card.dataset.searchText ?? "").includes(query));
					if (!card.hidden) count++;
				});
				group.hidden = count === 0;
				const counter = group.querySelector<HTMLElement>("[data-group-count]");
				if (counter) counter.textContent = String(count);
				visible += count;
			});
			this.querySelectorAll<HTMLButtonElement>("[data-group-target]").forEach((button) => {
				const matchingGroup = [...this.querySelectorAll<HTMLElement>("[data-group-id]")].find((group) => group.dataset.groupId === button.dataset.groupTarget);
				button.hidden = Boolean(matchingGroup?.hidden);
			});
			const total = this.querySelector<HTMLElement>("[data-result-count]");
			if (total) total.textContent = `找到 ${visible} 个网站`;
			const empty = this.querySelector<HTMLElement>("[data-no-results]");
			if (empty) empty.hidden = visible !== 0;
		}
	}
	if (!customElements.get("booknav-list")) customElements.define("booknav-list", SpaceBookmarkList);
</script>
