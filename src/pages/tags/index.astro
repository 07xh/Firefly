---
import { Icon } from "astro-icon/components";
import TaxonomySearch from "@/components/portfolio/TaxonomySearch.astro";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/space-taxonomy.css";
import { getSortedPostsList } from "@/utils/content-utils";
import { getTagUrl, url } from "@/utils/url-utils";

export const prerender = true;

const posts = await getSortedPostsList();
const counts = new Map<string, number>();
for (const { data } of posts) {
	for (const raw of data.tags || []) {
		const tag = raw.trim();
		if (tag) counts.set(tag, (counts.get(tag) ?? 0) + 1);
	}
}
const tags = [...counts.entries()]
	.map(([name, count]) => ({ name, count, link: getTagUrl(name) }))
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<PortfolioLayout title="文章标签" description="按关键词浏览已发布的文章。">
	<taxonomy-directory class="space-library-page" data-unit="个标签">
		<header class="space-library-heading">
			<div>
				<h1>文章标签</h1>
				<p>用关键词找到相关笔记。</p>
			</div>
			<a href={url("/categories/")} class="space-library-secondary-link">
				查看分类 <Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
			</a>
		</header>
		<TaxonomySearch placeholder="搜索标签" count={tags.length} unit="个标签" />
		<div class="space-tags-grid">
			{tags.map(({ name, count, link }) => (
				<a
					href={link}
					class="space-tag-link"
					data-taxonomy-item
					data-search-text={name.toLocaleLowerCase()}
				>
					<span class="space-tag-hash">#</span>
					<strong>{name}</strong>
					<span class="space-tag-total">{count}</span>
				</a>
			))}
		</div>
		<div class="space-taxonomy-empty" data-taxonomy-empty hidden>
			<p>没有找到匹配的标签。</p>
		</div>
	</taxonomy-directory>
</PortfolioLayout>
