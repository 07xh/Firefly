---
import { Icon } from "astro-icon/components";
import TaxonomySearch from "@/components/portfolio/TaxonomySearch.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/space-taxonomy.css";
import { getSortedPostsList } from "@/utils/content-utils";
import { getCategoryUrl, url } from "@/utils/url-utils";

export const prerender = true;

const posts = await getSortedPostsList();
const counts = new Map<string, number>();
for (const { data } of posts) {
	const category = data.category?.trim() || "";
	counts.set(category, (counts.get(category) ?? 0) + 1);
}
const categories = [...counts.entries()]
	.map(([category, count]) => ({
		name: category || i18n(I18nKey.uncategorized),
		url: getCategoryUrl(category || null),
		count,
	}))
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<PortfolioLayout title={i18n(I18nKey.categories)} description="按分类查找已发布的文章。">
	<taxonomy-directory class="space-library-page" data-unit="个分类">
		<header class="space-library-heading">
			<div>
				<h1>文章分类</h1>
				<p>按主题快速找到需要的文章。</p>
			</div>
			<a href={url("/posts/")} class="space-library-secondary-link">
				全部文章 <Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
			</a>
		</header>
		<TaxonomySearch placeholder="搜索分类" count={categories.length} unit="个分类" />
		<div class="space-taxonomy-grid">
			{categories.map(({ name, url: categoryUrl, count }) => (
				<a class="space-taxonomy-card" href={categoryUrl} data-taxonomy-item data-search-text={name.toLocaleLowerCase()}>
					<span class="space-taxonomy-card-icon" aria-hidden="true">
						<Icon name="material-symbols:folder-open-rounded" />
					</span>
					<span class="space-taxonomy-card-main">
						<strong>{name}</strong>
						<span>{count} 篇文章</span>
					</span>
					<Icon name="material-symbols:arrow-forward-rounded" class="space-taxonomy-card-arrow" aria-hidden="true" />
				</a>
			))}
		</div>
		<div class="space-taxonomy-empty" data-taxonomy-empty hidden>
			<p>没有找到匹配的分类。</p>
		</div>
	</taxonomy-directory>
</PortfolioLayout>
