---
import { Icon } from "astro-icon/components";
import TaxonomySearch from "@/components/portfolio/TaxonomySearch.astro";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/space-taxonomy.css";
import { getSeriesList } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

export const prerender = true;

const seriesList = await getSeriesList();
const totalPosts = seriesList.reduce((sum, series) => sum + series.count, 0);
---

<PortfolioLayout title="文章系列" description="按顺序阅读同一系列的文章。">
	<taxonomy-directory class="space-library-page space-series-page" data-unit="个系列">
		<header class="space-library-heading">
			<div>
				<h1>文章系列</h1>
				<p>{seriesList.length} 个系列，{totalPosts} 篇文章。按顺序阅读更方便。</p>
			</div>
			<a href={url("/topics/")} class="space-library-secondary-link">
				知识专题 <Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
			</a>
		</header>
		<TaxonomySearch placeholder="搜索系列名称或章节" count={seriesList.length} unit="个系列" />
		<div class="space-series-list">
			{seriesList.map((series, seriesIndex) => (
				<details
					class="space-series-card"
					data-taxonomy-item
					data-search-text={[
						series.name,
						...series.posts.map(({ data }) => data.title),
					].join(" ").toLocaleLowerCase()}
					open={seriesIndex === 0}
				>
					<summary>
						<span class="space-series-icon" aria-hidden="true">
							<Icon name="material-symbols:menu-book-rounded" />
						</span>
						<span class="space-series-heading">
							<strong>{series.name}</strong>
							<span>{series.count} 篇 · 按章节排列</span>
						</span>
						<Icon name="material-symbols:keyboard-arrow-down-rounded" class="space-series-chevron" aria-hidden="true" />
					</summary>
					<div class="space-series-body">
						{series.posts[0] && (
							<a class="space-series-start" href={getPostUrlBySlug(series.posts[0].id)}>
								阅读第一篇 <Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
							</a>
						)}
						<ol class="space-series-chapters">
							{series.posts.map((post, index) => (
								<li>
									<a href={getPostUrlBySlug(post.id)}>
										<span class="space-series-chapter-number">{String(index + 1).padStart(2, "0")}</span>
										<span class="space-series-chapter-title">{post.data.title}</span>
										<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
									</a>
								</li>
							))}
						</ol>
					</div>
				</details>
			))}
		</div>
		<div class="space-taxonomy-empty" data-taxonomy-empty hidden>
			<p>没有找到匹配的系列。</p>
		</div>
	</taxonomy-directory>
</PortfolioLayout>
