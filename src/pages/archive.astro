---
// biome-ignore-all assist/source/organizeImports: Preserve established Astro alias import order on this route.
import { Icon } from "astro-icon/components";
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import PortfolioLayout from "@layouts/PortfolioLayout.astro";
import "@/styles/space-taxonomy.css";
import { url } from "@/utils/url-utils";
---

<PortfolioLayout title="文章归档" description="按年份查看网站已经发布的文章。">
	<section class="space-library-page">
		<header class="space-library-heading">
			<div>
				<h1>文章归档</h1>
				<p>所有已发布的文章，按年份整理。</p>
			</div>
			<a href={url("/posts/")} class="space-library-secondary-link">
				返回文章列表 <Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
			</a>
		</header>
		<ArchivePanel />
	</section>
</PortfolioLayout>
