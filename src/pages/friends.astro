---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import { commentConfig, friendsPageConfig, getEnabledFriends, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/space-utility.css";

if (!siteConfig.pages.friends) return Astro.redirect("/404/");

const entry = await getEntry("spec", "friends");
if (!entry) throw new Error("friends page content not found");
const { Content } = await render(entry);
const friends = getEnabledFriends();
const tags = [...new Set(friends.flatMap((friend) => friend.tags || []))].sort();
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description = friendsPageConfig.description || "推荐的网站与值得关注的创作者。";
const commentsEnabled = commentConfig.type !== "none" && friendsPageConfig.showComment !== false;
---

<PortfolioLayout title={title} description={description}>
	<friend-directory class="space-utility-page space-friends-page">
		<header class="space-utility-heading">
			<div>
				<h1>{title}</h1>
				<p>{description}</p>
			</div>
			<span class="space-utility-caption">{friends.length} 个链接</span>
		</header>
		{friends.length > 0 ? (
			<>
				<label class="space-utility-search">
					<Icon name="material-symbols:search-rounded" aria-hidden="true" />
					<span class="sr-only">搜索友链名称、简介或标签</span>
					<input data-search type="search" autocomplete="off" placeholder="搜索网站名称、简介或标签" />
				</label>
				<nav class="space-utility-filters" aria-label="友链标签">
					<button type="button" data-tag="" aria-pressed="true">全部 <span>{friends.length}</span></button>
					{tags.map((tag) => (
						<button type="button" data-tag={tag} aria-pressed="false">{tag}</button>
					))}
				</nav>
				<div class="space-utility-count-row">
					<span data-result-count aria-live="polite">共 {friends.length} 个链接</span>
					<button type="button" data-clear-filters hidden>清除筛选</button>
				</div>
				<div class="space-friends-grid">
					{friends.map((friend) => (
						<a
							class="space-friend-card"
							href={friend.siteurl}
							target="_blank"
							rel="noopener noreferrer"
							data-friend
							data-tags={JSON.stringify(friend.tags || [])}
							data-search-text={[friend.title, friend.desc, ...(friend.tags || [])].join(" ").toLocaleLowerCase()}
						>
							<span class="space-friend-avatar">
								<img src={friend.imgurl} alt="" loading="lazy" decoding="async" />
							</span>
							<span class="space-friend-info">
								<strong>{friend.title}</strong>
								<span class="space-friend-description">{friend.desc}</span>
								{friend.tags?.length > 0 && (
									<span class="space-friend-tags">{friend.tags.slice(0, 3).map((tag) => <small>{tag}</small>)}</span>
								)}
							</span>
							<Icon class="space-friend-arrow" name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
						</a>
					))}
				</div>
				<div class="space-utility-empty" data-no-results hidden>
					<p>没有找到匹配的友链。</p>
					<button type="button" data-clear-filters>清除筛选</button>
				</div>
			</>
		) : (
			<div class="space-utility-empty"><p>{i18n(I18nKey.friendsEmpty)}</p></div>
		)}
		{friendsPageConfig.showCustomContent !== false && (
			<section class="space-utility-copy space-friends-extra">
				<Markdown class="space-utility-markdown"><Content /></Markdown>
			</section>
		)}
		{commentsEnabled && (
			<section class="space-utility-comments">
				<Comment post={entry} customPath="/friends/" />
			</section>
		)}
	</friend-directory>
</PortfolioLayout>

<script>
	class SpaceFriendDirectory extends HTMLElement {
		private activeTag = "";
		connectedCallback() {
			this.addEventListener("click", this.onClick);
			this.addEventListener("input", this.onInput);
			this.update();
		}
		disconnectedCallback() {
			this.removeEventListener("click", this.onClick);
			this.removeEventListener("input", this.onInput);
		}
		private onInput = (event: Event) => {
			if (event.target instanceof Element && event.target.matches("[data-search]")) this.update();
		};
		private onClick = (event: MouseEvent) => {
			if (!(event.target instanceof Element)) return;
			const tag = event.target.closest<HTMLButtonElement>("button[data-tag]");
			if (tag) this.activeTag = tag.dataset.tag ?? "";
			else if (event.target.closest("[data-clear-filters]")) {
				this.activeTag = "";
				const input = this.querySelector<HTMLInputElement>("[data-search]");
				if (input) { input.value = ""; input.focus(); }
			} else return;
			this.update();
		};
		private update() {
			const query = this.querySelector<HTMLInputElement>("[data-search]")?.value.trim().toLocaleLowerCase() ?? "";
			let count = 0;
			this.querySelectorAll<HTMLElement>("[data-friend]").forEach((card) => {
				let tags: string[] = [];
				try { tags = JSON.parse(card.dataset.tags ?? "[]") as string[]; } catch { tags = []; }
				const tagMatches = !this.activeTag || tags.includes(this.activeTag);
				const textMatches = !query || (card.dataset.searchText ?? "").includes(query);
				card.hidden = !(tagMatches && textMatches);
				if (!card.hidden) count++;
			});
			this.querySelectorAll<HTMLButtonElement>("button[data-tag]").forEach((button) => {
				button.setAttribute("aria-pressed", String((button.dataset.tag ?? "") === this.activeTag));
			});
			const total = this.querySelector<HTMLElement>("[data-result-count]");
			if (total) total.textContent = `找到 ${count} 个链接`;
			this.querySelectorAll<HTMLElement>("[data-clear-filters]").forEach((button) => {
				button.hidden = !query && !this.activeTag;
			});
			const empty = this.querySelector<HTMLElement>("[data-no-results]");
			if (empty) empty.hidden = count !== 0;
		}
	}
	if (!customElements.get("friend-directory")) customElements.define("friend-directory", SpaceFriendDirectory);
</script>
