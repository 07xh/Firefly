async function loadSettings(){
 const status=$("settingsStatus");
 $("settingsForm").inert = true;
 updateSettingsDirtyState();
 status.textContent="正在读取全局配置…";status.style.color="#657267";
 try{
  const response=await fetch("/api/admin/settings/",{credentials:"same-origin",cache:"no-store"});
  if(response.status===401){goLogin();return}
  const data=await response.json().catch(()=>({error:"配置接口返回无法解析的响应"}));
  if(!response.ok)throw new Error(data.error||"读取全局配置失败");
  for(const id of ["bannerTitle","bannerSubtitle","backgroundImage","backgroundColor","avatar","nickname","bio","announcement","githubUrl","email","backgroundMusic","aboutContent","sourceGithubUrl","donationQrCode"]){
   $(id).value=typeof data[id]==="string"?data[id]:"";
  }
  $("backgroundColorPicker").value=/^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(data.backgroundColor||"")?expandColor(data.backgroundColor):"#f3f6f3";
