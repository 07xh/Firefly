  background:#f9fcf9;
}
.editor-reading-controls__label {
  color:#526257;
  font-size:12px;
  font-weight:700;
  margin-right:2px;
}
.editor-reading-controls button {
  min-width:38px;
  min-height:34px;
  padding:5px 9px;
  border:1px solid #d5e2d7;
  border-radius:8px;
  background:#fff;
  color:#285237;
  font:inherit;
  font-size:13px;
  font-weight:650;
  cursor:pointer;
}
.editor-reading-controls button:hover:not(:disabled) {
  border-color:#8fcaa0;
