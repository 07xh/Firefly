    $("tags").value = Array.isArray(draft.tags) ? draft.tags.join(", ") : "";
    $("published").value = $("published").value || todayInBeijing();
    $("draft").checked = true;
    updateSaveButtonLabel();
  } else {
    if ((selected?.path || null) !== draft.targetPath || currentArticleSnapshot() !== draft.sourceSnapshot) {
      aiDraftResult = null;
      $("aiResult").hidden = true;
      setAiStatus("生成草稿后，当前文章或正文状态发生了变化。为避免覆盖其他内容，请重新生成修改稿。", true);
      return;
    }
    if (!confirm("使用 AI 修改稿会替换当前正文。其他文章信息将保持不变。是否继续？")) return;
  }
  $("body").value = draft.body;
  window.dispatchEvent(new CustomEvent("firefly:source-loaded"));
  showVisualTab();
  updateArticleDirtyState();
  say("AI 内容已填入编辑器，尚未保存或发布。请检查预览与正文后再操作。");
  await renderMarkdownPreview();
};

