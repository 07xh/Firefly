function editAiProvider(id){
 const item=aiProviderRecords.find(provider=>provider.id===id);
 if(!item)return;
 aiProviderCurrentId=item.id;
 $("aiProviderName").value=item.name;
 $("aiProviderId").value=item.id;
 $("aiProviderBaseUrl").value=item.baseUrl;
 $("aiProviderModel").value=item.model;
 $("aiProviderKey").value="";
 $("aiProviderKey").required=false;
 $("aiProviderKeyHelp").textContent=item.hasApiKey?"已保存密钥（"+ "••••••••" +"）。留空表示保留原密钥；输入新 Key 会替换旧密钥。":"尚未保存密钥，请输入 API Key。";
 $("aiProviderKey").required=!item.hasApiKey;
 $("aiProviderEnabled").checked=item.enabled;
 $("aiProviderSave").textContent="保存服务配置";
 setAiProviderStatus("正在编辑："+item.name);
}
function renderAiProviderList(data){
 aiProviderRecords=Array.isArray(data.providers)?data.providers:[];
 const list=$("aiProviderList");
 if(!aiProviderRecords.length){
  list.innerHTML='<p class="muted">尚无服务配置。请在下方添加服务商、模型和 API Key。</p>';
  return;
 }
 list.replaceChildren();
 for(const item of aiProviderRecords){
  const card=document.createElement("div");card.className="ai-provider-card";
  const info=document.createElement("div");info.style.minWidth="0";
  const name=document.createElement("strong");name.textContent=item.name+(data.activeId===item.id?" · 当前使用":"");
  const meta=document.createElement("small");meta.textContent=item.model+" · "+item.baseUrl+" · API Key："+(item.hasApiKey?"已加密保存":"未配置");
  info.append(name,meta);
  const right=document.createElement("div");right.style.display="flex";right.style.gap="8px";right.style.alignItems="center";right.style.flexWrap="wrap";
  const badge=document.createElement("span");badge.className="ai-provider-badge"+(item.enabled?"":" off");badge.textContent=item.enabled?"已启用":"已停用";
  const edit=document.createElement("button");edit.type="button";edit.className="btn";edit.textContent="编辑";edit.onclick=()=>editAiProvider(item.id);
  right.append(badge,edit);card.append(info,right);list.append(card);
 }
}
async function loadAiProviders(){
 $("aiProviderForm").setAttribute("aria-busy","true");
 try{
  const response=await fetch("/api/admin/ai-providers/",{credentials:"same-origin",cache:"no-store"});
  if(response.status===401){goLogin();return}
  const data=await response.json().catch(()=>({error:"AI 服务配置接口响应无法解析"}));
  if(!response.ok)throw new Error(data.error||"读取 AI 服务配置失败");
  renderAiProviderList(data);aiProvidersLoaded=true;
  if(!aiProviderCurrentId&&aiProviderRecords.length)editAiProvider(data.activeId||aiProviderRecords[0].id);
  if(!aiProviderRecords.length)resetAiProviderForm();
  setAiProviderStatus("配置已读取；完整 API Key 不会返回到浏览器。");
 }catch(error){
  setAiProviderStatus(error instanceof Error?error.message:"读取配置失败",true);
  $("aiProviderList").textContent="无法读取 AI 服务配置。请确认后台登录状态和 Worker 配置。";
 }finally{$("aiProviderForm").removeAttribute("aria-busy")}
}
