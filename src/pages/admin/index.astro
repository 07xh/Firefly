$("aiApply").onclick = async () => {
  if (!aiDraftResult) return;
  const draft = aiDraftResult;
  if (draft.mode === "generate") {
    if ((selected || isArticleDirty()) && !confirm("应用 AI 新文章会清空当前表单内容；未保存的修改可能丢失。是否继续？")) return;
    if (selected || isArticleDirty()) reset();
    $("slug").disabled = false;
    $("title").value = draft.title || "";
    $("slug").value = draft.slug || "";
