async function watchDeployment(sha,attempt=0,successMessage="Cloudflare 部署成功，正式网站已更新。"){try{const r=await fetch("/api/admin/deployment-status/?sha="+encodeURIComponent(sha),{cache:"no-store"});if(r.status===401){goLogin();return}const d=await r.json().catch(()=>({error:"无法读取部署状态"}));if(!r.ok)throw new Error(d.error||"暂时无法查询部署状态");if(d.url){$("deployLink").href=d.url;$("deployLink").hidden=false}if(d.status==="success"){say(successMessage);return}if(d.status==="failure"){say("Cloudflare 部署失败，请打开部署日志检查。",true);return}if(attempt>=24){say("文章已提交到 GitHub，但部署仍未确认；可查看最新工作流日志。");return}say(d.status==="running"?"文章已提交，Cloudflare 正在构建/部署…":"文章已提交，正在等待 Cloudflare 部署启动…");setTimeout(()=>watchDeployment(sha,attempt+1,successMessage),12000)}catch(e){if(attempt>=24){say("文章已提交到 GitHub，但仍无法确认部署状态："+e.message,true);return}say("正在查询 Cloudflare 部署状态…");setTimeout(()=>watchDeployment(sha,attempt+1,successMessage),12000)}}
async function checkGitHubPermission(){
 const button=$("checkGitHub");
 button.disabled=true;
 const originalText=button.textContent;
 button.textContent="检测中…";
 say("正在用 Worker 当前配置的 Token 检查 GitHub 权限，不会创建文章…");
 try{
  const response=await fetch("/api/admin/github-check/",{cache:"no-store"});
  const data=await response.json().catch(()=>({message:"诊断接口返回了无法解析的响应"}));
  const pieces=[
   "阶段："+(data.stage||"unknown"),
   "GitHub HTTP："+(data.githubStatus??response.status),
   data.result?"结果："+data.result:"",
   data.githubMessage||data.message||"",
   data.requestId?"GitHub Request ID："+data.requestId:"",
   data.acceptedPermissions?"GitHub accepted permissions："+data.acceptedPermissions:""
  ].filter(Boolean);
  say(pieces.join("；"),Boolean(!data.ok));
 }catch(error){
  say("无法运行 GitHub 权限诊断："+(error instanceof Error?error.message:String(error)),true);
 }finally{
  button.disabled=false;
  button.textContent=originalText;
 }
}

