    if (!selected && !/^[\p{L}\p{N}][\p{L}\p{N}_-]{0,79}$/u.test(slug)) { say("阶段 1/4：文件名须以字母或数字开头，且仅包含字母、数字、连字符或下划线；支持中文。", true); $("slug").focus(); return; }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(published) || Number.isNaN(Date.parse(published + "T00:00:00Z"))) { say("阶段 1/4：请选择有效的发布日期。", true); $("published").focus(); return; }
    if (rawSchedule && mode !== "publish" && !date) { say("阶段 1/4：定时发布时间无效，请重新选择。", true); $("date").focus(); return; }
    if ($("body").value.length > 500000) { say("阶段 1/4：正文超过 500 KB 限制。", true); return; }
    if (mode === "publish" && !window.confirm("直接发布会立即公开文章，并清除定时发布时间。确定继续吗？")) return;
    if (mode === "publish") $("date").value = "";
    const isDraft = mode === "publish" ? false : $("draft").checked;
    $("draft").checked = isDraft;
    const password = $("articlePassword").value;
    const passwordHint = $("passwordHint").value;
    if (password.length > 200 || passwordHint.length > 120) { say("阶段 1/4：密码最多 200 个字符，密码提示最多 120 个字符。", true); return; }
    if (date && Date.parse(date) <= Date.now() && !isDraft && mode !== "publish") {
      say("阶段 1/4：所选发布时间已到，请直接发布或选择未来时间。", true); $("date").focus(); return;
    }
    const metadata = {
      title, published, date, password, passwordHint,
      category: $("category").value, description: $("description").value,
      tags: $("tags").value.split(",").map(x => x.trim()).filter(Boolean), draft: isDraft
    };
    const data = selected
      ? { path: selected.path, sha: selected.sha, rawContent: $("body").value, ...metadata }
      : { ...metadata, slug, body: $("body").value };
    const buttons = [$("saveDraft"), $("publish")];
    buttons.forEach(button => button.disabled = true);
    say("阶段 1/4：本地表单校验通过，正在准备 GitHub 写入…");
    try {
      const result = await api(selected ? "PUT" : "POST", data);
      if (!result.commitSha) throw new Error("GitHub 已响应，但未返回 Commit SHA，无法跟踪部署。请刷新列表确认写入结果。");
      const scheduled = !isDraft && Boolean(date && Date.parse(date) > Date.now());
      const savedPath = selected?.path || ("src/content/posts/" + slug + ".md");
      window.dispatchEvent(new CustomEvent("firefly:save-complete", { detail: { path: savedPath, slug } }));
      reset();
      await refresh();
      const commit = $("enhancedCommitLink");
      commit.href = result.commitUrl || ("https://github.com/07xh/Firefly/commit/" + encodeURIComponent(result.commitSha));
      commit.hidden = false;
      if (isDraft) say("阶段 2/4：已成功写入 GitHub，文章保留在草稿箱。Commit SHA：" + result.commitSha);
      else if (scheduled) say("阶段 2/4：定时文章已写入 GitHub，等待指定时间到达后自动重建。Commit SHA：" + result.commitSha);
      else say("阶段 2/4：已成功写入 GitHub。Commit SHA：" + result.commitSha);
      watchDeployment(result.commitSha, 0, isDraft, scheduled);
    } catch (error) {
      say(error instanceof Error ? error.message : "保存文章失败。", true);
    } finally {
      buttons.forEach(button => button.disabled = false);
    }
  }, true);

  // Readability controls affect only this browser tab and never edit Markdown content.
  const readingControls = $("editorReadingControls");
  if (readingControls) {
    const minReadingSize = 14;
    const maxReadingSize = 22;
    const readingStep = 2;
    const defaultReadingSize = 16;
    const readingStorageKey = "firefly-admin-reading-size";
    const smallerButton = $("editorReadingSmaller");
    const largerButton = $("editorReadingLarger");
    const resetButton = $("editorReadingReset");
    const sizeOutput = $("editorReadingSizeValue");
    let readingSize = defaultReadingSize;

    const applyReadingSize = (requestedSize, persist = true) => {
      const numericSize = Number(requestedSize);
      const normalized = Number.isFinite(numericSize) ? numericSize : defaultReadingSize;
      readingSize = Math.max(minReadingSize, Math.min(maxReadingSize, normalized));
      document.documentElement.style.setProperty("--firefly-reading-size", readingSize + "px");
      document.documentElement.style.setProperty(
        "--firefly-reading-source-size",
        Math.max(13, Math.min(18, readingSize - 2)) + "px",
      );
      document.documentElement.style.setProperty(
        "--firefly-reading-code-size",
        Math.max(12, Math.min(16, readingSize - 3)) + "px",
      );
      if (sizeOutput) sizeOutput.textContent = readingSize + " px";
      if (smallerButton) smallerButton.disabled = readingSize <= minReadingSize;
      if (largerButton) largerButton.disabled = readingSize >= maxReadingSize;
      if (persist) {
        try {
          sessionStorage.setItem(readingStorageKey, String(readingSize));
        } catch {
          // The default readable size still works when storage is unavailable.
        }
      }
    };

    smallerButton?.addEventListener("click", () => applyReadingSize(readingSize - readingStep));
    largerButton?.addEventListener("click", () => applyReadingSize(readingSize + readingStep));
    resetButton?.addEventListener("click", () => applyReadingSize(defaultReadingSize));

    let initialReadingSize = defaultReadingSize;
    try {
      const savedSize = Number(sessionStorage.getItem(readingStorageKey));
      if (Number.isFinite(savedSize) && savedSize >= minReadingSize && savedSize <= maxReadingSize) {
        initialReadingSize = savedSize;
      }
    } catch {
      // Ignore blocked storage and use the default size.
    }
    applyReadingSize(initialReadingSize, false);
  }

  // Refresh the filter options after the initial asynchronous article fetch.
  const initialRefresh = refresh;
  refresh = async function() { await initialRefresh(); populateFilters(); render(); };
  refresh();
})();

</script><script type="module" src="/admin-wysiwyg.js?v=20261018-editor-reading-controls"></script></body></html>
