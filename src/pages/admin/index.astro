---
import "../../styles/admin-index.css";

export const prerender = false;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>文章管理 · Firefly</title>
<style>
:root{font-family:system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;color:#202820;background:#f3f6f3}*{box-sizing:border-box}body{margin:0}header{padding:16px max(18px,calc((100vw - 1100px)/2));background:white;border-bottom:1px solid #e1e8e1;display:flex;justify-content:space-between;align-items:center}h1{font-size:19px;margin:0}.wrap{max-width:1100px;margin:18px auto 26px;padding:0 16px}.articles-grid{display:grid;grid-template-columns:320px minmax(0,1fr);gap:18px}.admin-tabs{max-width:1100px;margin:20px auto 0;padding:0 16px;display:flex;gap:8px;border-bottom:1px solid #e3eae4}.admin-tab{border:1px solid transparent;border-bottom:0;border-radius:10px 10px 0 0;padding:10px 14px;background:transparent;color:#718075;cursor:pointer;font:inherit;font-size:13px;transition:background .15s,color .15s,border-color .15s}.admin-tab:hover{background:#f7faf7;color:#16834c}.admin-tab[aria-selected=true]{border-color:#d8e9dd;background:white;color:#12884f;font-weight:650;box-shadow:0 -1px 0 #fff inset}#articlesTabPanel[hidden],#appearanceTabPanel[hidden]{display:none!important}.settings-panel{max-width:780px;margin:0 auto}.settings-field{display:grid;gap:7px;margin-bottom:18px}.settings-field>label{font-size:13px;color:#334155;font-weight:650}.settings-field>small{color:#718075;font-size:12px;line-height:1.6}.settings-control{width:100%;border:1px solid #d8e1d8;border-radius:9px;padding:10px 12px;font:inherit;font-size:13px;background:white;color:#202820;transition:border-color .15s,box-shadow .15s}.settings-control:focus{border-color:#10b981;outline:none;box-shadow:0 0 0 3px #10b98122}#bio{min-height:120px;font-family:inherit;line-height:1.65}.settings-preview{display:flex;align-items:center;gap:12px;padding:10px;border:1px solid #edf1ed;border-radius:10px;background:#f8faf8}.settings-preview img{width:112px;height:64px;object-fit:cover;border-radius:7px;background:#eef2ee}.settings-preview-note{font-size:12px;color:#8b968e}.admin-tab:focus-visible{outline:2px solid #10b981;outline-offset:2px}.panel{background:white;border:1px solid #e0e7e0;border-radius:14px;padding:18px;min-width:0}.btn{border:1px solid #d5dfd5;border-radius:8px;background:white;color:#263329;padding:9px 12px;cursor:pointer}.primary{background:#12884f;color:white;border-color:#12884f}.danger{color:#b42318}.toolbar{display:flex;gap:8px;margin-bottom:12px}.toolbar input{min-width:0;flex:1}.toolbar select{max-width:100px;border:1px solid #d8e1d8;border-radius:8px;padding:8px 5px;background:white;color:#263329;font:inherit;font-size:12px}.field{display:grid;gap:6px;margin-bottom:13px}.field label{font-size:12px;color:#59675d;font-weight:650}.field input,.field textarea,.toolbar input{width:100%;border:1px solid #d8e1d8;border-radius:8px;padding:10px;font:inherit;background:white;color:#202820}.field textarea{min-height:240px;resize:vertical;font-family:ui-monospace,monospace;line-height:1.6}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.item{width:100%;display:block;text-align:left;background:white;border:1px solid #e3e9e3;border-radius:9px;padding:11px;margin-bottom:8px;cursor:pointer;color:inherit}.article-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;margin-bottom:8px;align-items:stretch}.article-row .item{margin:0}.article-delete{border:1px solid #f1c6c3;border-radius:8px;background:#fff8f7;color:#b42318;padding:8px;cursor:pointer;min-width:48px}.article-delete:disabled{opacity:.55;cursor:wait}.item strong,.item small{display:block;overflow-wrap:anywhere}.item strong{font-size:13px}.item small,.muted{color:#718075;font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap}.status{min-height:20px;font-size:12px;margin-top:12px;color:#657267;overflow-wrap:anywhere}.check{display:flex;gap:8px;align-items:center;font-size:13px;margin:12px 0}.empty{color:#758077;font-size:13px;line-height:1.7}.editor-tabs{display:flex;gap:8px;margin:2px 0 9px}.editor-tabs .active{background:#eaf6ee;border-color:#b6dbc3;color:#127947}.markdown-preview{min-height:240px;border:1px solid #d8e1d8;border-radius:8px;padding:14px;line-height:1.75;overflow-wrap:anywhere;color:#202820}.markdown-preview h1,.markdown-preview h2,.markdown-preview h3{line-height:1.35;margin:1.1em 0 .6em}.markdown-preview p,.markdown-preview ul,.markdown-preview ol,.markdown-preview blockquote{margin:.65em 0}.markdown-preview pre{overflow:auto;background:#f3f6f3;padding:12px;border-radius:8px}.markdown-preview code{font-family:ui-monospace,monospace;background:#f3f6f3;padding:2px 4px;border-radius:4px}.markdown-preview pre code{padding:0}.markdown-preview img{max-width:100%;height:auto}.markdown-preview table{border-collapse:collapse;max-width:100%;display:block;overflow:auto}.markdown-preview th,.markdown-preview td{border:1px solid #d8e1d8;padding:6px 9px}.markdown-preview blockquote{border-left:3px solid #b6dbc3;padding-left:12px;color:#59675d}.deploy-link{display:inline-block;margin-top:7px;color:#12884f;font-size:12px}.actions .btn{min-width:100px}@media(max-width:720px){.wrap{margin-top:12px}.articles-grid{grid-template-columns:1fr}.admin-tabs{margin-top:12px;padding:0 12px}.admin-tab{padding:10px 9px;font-size:12px}.settings-panel{padding:16px}.grid{grid-template-columns:1fr}.list{max-height:260px;overflow:auto}header{padding:13px 15px}}
</style></head>
<body>
<header><h1>✦ Firefly 文章管理</h1><div style="display:flex;gap:12px;align-items:center"><a href="/" style="color:#16864f;font-size:13px">返回网站 ↗</a><button class="btn" id="logout" type="button">退出登录</button></div></header>
<nav class="admin-tabs" role="tablist" aria-label="后台管理模块">
  <button id="tabArticles" class="admin-tab" type="button" role="tab" aria-selected="true" aria-controls="articlesTabPanel">📝 文章管理</button>
  <button id="tabAppearance" class="admin-tab" type="button" role="tab" aria-selected="false" aria-controls="appearanceTabPanel" tabindex="-1">🎨 全局外观配置</button>
</nav>
<main class="wrap">
<div id="articlesTabPanel" class="articles-grid" role="tabpanel" aria-labelledby="tabArticles">
<section
  class="min-w-0 rounded-xl border border-gray-200/80 bg-white p-4 shadow-sm"
>
  <div class="mb-4 flex items-center justify-between gap-3">
    <h2 class="text-base font-semibold text-gray-800">文章管理</h2>
    <button
      id="refresh"
      type="button"
      class="inline-flex shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-600 transition hover:border-emerald-200 hover:bg-emerald-50/50 hover:text-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30"
    >
      刷新
    </button>
  </div>

  <div class="mb-3 space-y-2">
    <input
      id="search"
      type="search"
      placeholder="搜索文章标题或路径…"
      aria-label="搜索文章"
      class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 transition hover:border-gray-300 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20"
    />
    <select
      id="statusFilter"
      aria-label="筛选文章状态"
      class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-700 transition hover:border-gray-300 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20"
    >
      <option value="all">全部文章</option>
      <option value="published">已发布</option>
      <option value="draft">草稿</option>
    </select>
  </div>

  <button
    id="new"
    type="button"
    class="mb-4 flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-emerald-700 hover:shadow active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:ring-offset-2"
  >
    <span aria-hidden="true" class="text-base leading-none">+</span>
    新建文章
  </button>

  <div
    id="list"
    class="max-h-[60vh] space-y-1 overflow-y-auto pr-1"
    aria-label="文章列表"
  >
    <p class="rounded-lg px-3 py-8 text-center text-sm text-gray-400">
      正在读取文章列表…
    </p>
  </div>
</section>
<section class="min-w-0 rounded-xl border border-gray-200/80 bg-white p-4 shadow-sm"><h2 id="formTitle" style="font-size:16px;margin:0 0 16px">新建文章</h2><form id="editor">
<div class="field"><label for="title">标题 *</label><input id="title" required maxlength="200"></div>
<div class="grid"><div class="field"><label for="slug">文件名 *</label><input id="slug" required pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,79}" placeholder="my-post"></div><div class="field"><label for="published">发布日期 *</label><input id="published" type="date" required></div></div>
<div class="grid"><div class="field"><label for="category">分类</label><input id="category" maxlength="100"></div><div class="field"><label for="tags">标签（逗号分隔）</label><input id="tags" placeholder="技术, 随笔"></div></div>
<div class="field"><label for="description">摘要</label><input id="description" maxlength="500"></div>
<div class="field"><label for="body">正文 Markdown / 已有文章完整源文件（元数据以表单字段为准）</label><div class="editor-tabs"><button class="btn active" type="button" id="editorTab">编辑</button><button class="btn" type="button" id="previewTab">Markdown 预览</button></div><textarea id="body" spellcheck="false" placeholder="新建时填写正文；编辑已有文章时这里会显示完整 Markdown/MDX 源文件，保留全部 frontmatter 元数据。"></textarea><div id="markdownPreview" class="markdown-preview" hidden><p class="muted">点击“Markdown 预览”查看排版效果。</p></div></div>
<label class="check"><input id="draft" type="checkbox" disabled> 当前为草稿状态（由上方操作按钮决定）</label>
<div class="actions"><button class="btn" type="button" id="checkGitHub">检查 GitHub 写入权限</button><button class="btn" type="submit" id="saveDraft" value="draft">保存草稿</button><button class="btn primary" type="submit" id="publish" value="publish">发布文章</button><button class="btn danger" type="button" id="delete" disabled title="请先从左侧选择一篇已有文章">删除文章</button><button class="btn" type="button" id="reset">清空表单</button></div>
</form><div class="status" id="status" role="status" aria-live="polite"></div><p class="muted">保存草稿会将文章写入 GitHub 并触发构建，但保持草稿状态；发布文章会将 draft 设为 false，提交到 GitHub，并跟踪 Cloudflare 部署结果。</p><a id="deployLink" class="deploy-link" href="#" target="_blank" rel="noopener noreferrer" hidden>查看 Cloudflare 部署日志 ↗</a></section>
</div>
<section id="appearanceTabPanel" role="tabpanel" aria-labelledby="tabAppearance" class="settings-panel min-w-0 rounded-xl border border-gray-200/80 bg-white p-5 shadow-sm" hidden>
  <div class="mb-1 text-base font-semibold text-gray-800">全局外观配置</div>
  <p class="mb-5 text-sm leading-6 text-gray-500">
    配置保存在仓库的 <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs">src/data/settings.json</code>。
    保存会提交到 GitHub，并自动触发站点构建与部署。
  </p>
  <form id="settingsForm">
    <div class="settings-field">
      <label for="backgroundImage">背景图片链接</label>
      <input id="backgroundImage" name="backgroundImage" type="url" maxlength="2048" autocomplete="url" placeholder="https://example.com/background.jpg" class="settings-control">
      <div class="settings-preview" id="backgroundImagePreviewBox">
        <img id="backgroundImagePreview" alt="背景图片缩略预览" hidden>
        <span id="backgroundImagePreviewEmpty" class="settings-preview-note">填写 HTTP/HTTPS 图片链接后，在这里预览。</span>
        <span id="backgroundImagePreviewError" class="settings-preview-note" hidden>图片加载失败，请检查链接是否可公开访问。</span>
      </div>
      <small>填写后会覆盖主题当前的桌面与移动端默认壁纸；清空时恢复主题默认壁纸。</small>
    </div>
    <div class="settings-field">
      <label for="backgroundMusic">背景音乐外链</label>
      <input id="backgroundMusic" name="backgroundMusic" type="url" maxlength="2048" autocomplete="url" placeholder="https://example.com/music.mp3" class="settings-control">
      <audio id="backgroundMusicPreview" class="w-full" controls preload="none" hidden></audio>
      <small>填写可直接播放的 HTTP/HTTPS 音频地址。它会替换站点现有音乐播放器的默认曲目，不会自动播放；清空时恢复主题默认音乐。</small>
    </div>
    <div class="settings-field">
      <label for="bio">个人签名 / 简介</label>
      <textarea id="bio" name="bio" rows="4" maxlength="5000" placeholder="写一段介绍自己或博客的话……" class="settings-control"></textarea>
      <small>最多 5000 个字符。保存后会更新站点使用的个人简介配置。</small>
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button id="saveSettings" type="submit" class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:ring-offset-2 disabled:cursor-wait disabled:opacity-60">
        保存全局配置
      </button>
      <span id="settingsStatus" class="text-sm text-gray-500" role="status" aria-live="polite"></span>
    </div>
  </form>
</section>
</main>
<script>
// @ts-nocheck
const $=id=>document.getElementById(id);let articles=[],selected=null;
function goLogin(){location.assign("/admin/login/?next="+encodeURIComponent(location.pathname+location.search))}
function say(s,bad=false){$("status").textContent=s;$("status").style.color=bad?"#b42318":"#657267"}
function frontmatterValue(source,key){const match=source.match(new RegExp("^"+key+":\\s*(.*?)\\s*$","m"));if(!match)return "";const raw=match[1].trim();try{const parsed=JSON.parse(raw);if(Array.isArray(parsed))return parsed.map(String).join(", ");if(typeof parsed==="string")return parsed;if(parsed===null)return ""}catch{}if(raw.startsWith("'")&&raw.endsWith("'"))return raw.slice(1,-1).replace(/''/g,"'");return raw}
async function api(method,data){const r=await fetch("/api/admin/articles/",{method,headers:{"Content-Type":"application/json"},...(data?{body:JSON.stringify(data)}:{})});if(r.status===401){goLogin();throw new Error("登录已过期，正在跳转登录页…")}const d=await r.json().catch(()=>({error:"服务器响应无法解析"}));if(!r.ok)throw new Error(d.error||"请求失败");return d}
function render(){
 const q=$("search").value.trim().toLowerCase();
 const statusFilter=$("statusFilter").value;
 const list=$("list");
 list.replaceChildren();

 const items=articles.filter(a=>
  ((a.title||"").toLowerCase().includes(q)||(a.path||"").toLowerCase().includes(q)) &&
  (statusFilter==="all"||(statusFilter==="draft"?a.draft:!a.draft))
 );

 if(!items.length){
  const empty=document.createElement("p");
  empty.className="rounded-lg px-3 py-8 text-center text-sm text-gray-400";
  empty.textContent="没有找到文章";
  list.append(empty);
  return;
 }

 for(const a of items){
  const isActive=selected?.path===a.path;
  const row=document.createElement("div");
  row.className=[
   "group relative flex min-w-0 items-center gap-1 rounded-r-lg border-l-4 transition-colors duration-150",
   isActive
    ? "border-emerald-500 bg-emerald-50/60"
    : "border-transparent hover:bg-gray-50"
  ].join(" ");

  const item=document.createElement("button");
  item.type="button";
  item.className=[
   "min-w-0 flex-1 rounded-r-lg px-3 py-3 text-left",
   "focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-emerald-500/30"
  ].join(" ");

  const titleRow=document.createElement("span");
  titleRow.className="block truncate text-sm font-semibold text-gray-800";
  titleRow.textContent=a.title||"未命名文章";

  const pathRow=document.createElement("span");
  pathRow.className="mt-1 block truncate text-xs font-normal text-gray-400";
  pathRow.textContent=a.path;

  item.append(titleRow,pathRow);

  item.onclick=()=>{
   selected=a;
   $("formTitle").textContent="编辑文章";
   $("slug").value=a.path.split("/").pop().replace(/\.mdx?$/,"");
   $("slug").disabled=true;
   $("body").value=a.content||"";
   $("title").value=frontmatterValue(a.content||"","title")||a.title;
   $("published").value=frontmatterValue(a.content||"","published")||a.published;
   $("category").value=frontmatterValue(a.content||"","category");
   $("description").value=frontmatterValue(a.content||"","description");
   $("tags").value=frontmatterValue(a.content||"","tags");
   $("draft").checked=a.draft;
   $("saveDraft").textContent=a.draft?"保存草稿修改":"转为草稿";
   $("publish").textContent=a.draft?"发布这篇文章":"保存修改并发布";
   $("delete").disabled=false;
   say(
    a.content
     ?"已载入文章。标题、日期、分类、摘要和标签会与正文一起保存。"
     :"未能载入文章内容，请刷新后重试。",
    !a.content
   );
   render();
   $("editor").scrollIntoView({behavior:"smooth",block:"start"});
  };

  const del=document.createElement("button");
  del.type="button";
  del.textContent="删除";
  del.setAttribute("aria-label","删除文章："+a.title);
  del.className=[
   "mr-1 shrink-0 rounded-md px-2.5 py-2 text-xs font-medium text-rose-600 transition-colors",
   "hover:bg-rose-50 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500/40",
   "opacity-100 sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100"
  ].join(" ");

  del.onclick=async event=>{
   event.stopPropagation();
   if(!confirm("确定删除“"+a.title+"”？此操作会提交到 GitHub 并触发部署。"))return;
   del.disabled=true;
   try{
    await api("DELETE",{path:a.path,sha:a.sha});
    if(selected&&selected.path===a.path)reset();
    say("文章已删除，正在刷新列表…");
    await refresh();
   }catch(e){
    say(e.message,true);
   }finally{
    del.disabled=false;
   }
  };

  row.append(item,del);
  list.append(row);
 }
}
async function refresh(){try{say("正在读取 GitHub…");articles=await api("GET");render();say("已读取 "+articles.length+" 篇文章")}catch(e){say(e.message,true);$("list").textContent="读取失败，请确认服务端令牌和仓库权限已配置。"}}
function reset(){selected=null;for(const id of ["title","slug","published","category","tags","description","body"]){const field=$(id);if(field)field.value=id==="published"?new Date().toISOString().slice(0,10):""} $("draft").checked=false;$("slug").disabled=false;$("formTitle").textContent="新建文章";$("saveDraft").textContent="保存草稿";$("publish").textContent="发布文章";$("delete").disabled=true;showEditorTab();$("deployLink").hidden=true;$("deployLink").removeAttribute("href")}
function showEditorTab(){$("body").hidden=false;$("markdownPreview").hidden=true;$("editorTab").classList.add("active");$("previewTab").classList.remove("active")}
function showPreviewTab(){$("body").hidden=true;$("markdownPreview").hidden=false;$("editorTab").classList.remove("active");$("previewTab").classList.add("active")}
async function renderMarkdownPreview(){showPreviewTab();$("markdownPreview").innerHTML="<p class=muted>正在生成预览…</p>";try{const r=await fetch("/api/admin/preview/",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({markdown:$("body").value})});if(r.status===401){goLogin();return}const d=await r.json().catch(()=>({error:"预览响应无法解析"}));if(!r.ok)throw new Error(d.error||"Markdown 预览失败");$("markdownPreview").innerHTML=d.html||"<p class=muted>暂无内容</p>"}catch(e){$("markdownPreview").textContent=e.message}}
async function watchDeployment(sha,attempt=0){try{const r=await fetch("/api/admin/deployment-status/?sha="+encodeURIComponent(sha),{cache:"no-store"});if(r.status===401){goLogin();return}const d=await r.json().catch(()=>({error:"无法读取部署状态"}));if(!r.ok)throw new Error(d.error||"暂时无法查询部署状态");if(d.url){$("deployLink").href=d.url;$("deployLink").hidden=false}if(d.status==="success"){say("Cloudflare 部署成功，正式网站已更新。");return}if(d.status==="failure"){say("Cloudflare 部署失败，请打开部署日志检查。",true);return}if(attempt>=24){say("文章已提交到 GitHub，但部署仍未确认；可查看最新工作流日志。");return}say(d.status==="running"?"文章已提交，Cloudflare 正在构建/部署…":"文章已提交，正在等待 Cloudflare 部署启动…");setTimeout(()=>watchDeployment(sha,attempt+1),12000)}catch(e){if(attempt>=24){say("文章已提交到 GitHub，但仍无法确认部署状态："+e.message,true);return}say("正在查询 Cloudflare 部署状态…");setTimeout(()=>watchDeployment(sha,attempt+1),12000)}}
async function checkGitHubPermission(){
 const button=$("checkGitHub");
 button.disabled=true;
 const originalText=button.textContent;
 button.textContent="检测中…";
 say("正在用 Worker 当前配置的 Token 检查 GitHub 权限，不会创建文章…");
 try{
  const response=await fetch("/api/admin/github-check/",{cache:"no-store"});
  const data=await response.json().catch(()=>({message:"诊断接口返回了无法解析的响应"}));
  const pieces=[
   "阶段："+(data.stage||"unknown"),
   "GitHub HTTP："+(data.githubStatus??response.status),
   data.result?"结果："+data.result:"",
   data.githubMessage||data.message||"",
   data.requestId?"GitHub Request ID："+data.requestId:"",
   data.acceptedPermissions?"GitHub accepted permissions："+data.acceptedPermissions:""
  ].filter(Boolean);
  say(pieces.join("；"),Boolean(!data.ok));
 }catch(error){
  say("无法运行 GitHub 权限诊断："+(error instanceof Error?error.message:String(error)),true);
 }finally{
  button.disabled=false;
  button.textContent=originalText;
 }
}
function setAdminTab(tab){
 const showArticles=tab==="articles";
 $("articlesTabPanel").hidden=!showArticles;
 $("appearanceTabPanel").hidden=showArticles;
 $("tabArticles").setAttribute("aria-selected",String(showArticles));
 $("tabAppearance").setAttribute("aria-selected",String(!showArticles));
 $("tabArticles").tabIndex=showArticles?0:-1;
 $("tabAppearance").tabIndex=showArticles?-1:0;
}
$("tabArticles").onclick=()=>setAdminTab("articles");
$("tabAppearance").onclick=()=>setAdminTab("appearance");

function checkedExternalUrl(value){
 const trimmed=String(value||"").trim();
 if(!trimmed)return "";
 try{const url=new URL(trimmed);return url.protocol==="http:"||url.protocol==="https:"?url.href:""}catch{return ""}
}
function updateImagePreview(){
 const url=checkedExternalUrl($("backgroundImage").value);
 const img=$("backgroundImagePreview");
 const empty=$("backgroundImagePreviewEmpty");
 const error=$("backgroundImagePreviewError");
 img.hidden=true;error.hidden=true;
 if(!url){img.removeAttribute("src");empty.hidden=false;return}
 empty.hidden=true;img.hidden=false;img.src=url;
}
$("backgroundImagePreview").onload=()=>{$("backgroundImagePreview").hidden=false;$("backgroundImagePreviewError").hidden=true};
$("backgroundImagePreview").onerror=()=>{$("backgroundImagePreview").hidden=true;$("backgroundImagePreviewError").hidden=false;$("backgroundImagePreviewEmpty").hidden=true};
$("backgroundImage").addEventListener("input",updateImagePreview);

function updateMusicPreview(){
 const url=checkedExternalUrl($("backgroundMusic").value);
 const audio=$("backgroundMusicPreview");
 if(!url){audio.pause();audio.removeAttribute("src");audio.load();audio.hidden=true;return}
 if(audio.src!==url){audio.src=url;audio.load()}
 audio.hidden=false;
}
$("backgroundMusic").addEventListener("input",updateMusicPreview);

async function loadSettings(){
 const status=$("settingsStatus");status.textContent="正在读取全局配置…";
 try{
  const response=await fetch("/api/admin/settings/",{credentials:"same-origin",cache:"no-store"});
  if(response.status===401){goLogin();return}
  const data=await response.json().catch(()=>({error:"配置接口返回无法解析的响应"}));
  if(!response.ok)throw new Error(data.error||"读取全局配置失败");
  $("backgroundImage").value=typeof data.backgroundImage==="string"?data.backgroundImage:"";
  $("backgroundMusic").value=typeof data.backgroundMusic==="string"?data.backgroundMusic:"";
  $("bio").value=typeof data.bio==="string"?data.bio:"";
  updateImagePreview();updateMusicPreview();status.textContent="已加载仓库中的配置。";
 }catch(error){
  status.textContent=error instanceof Error?error.message:"读取全局配置失败。";status.style.color="#b42318";
 }
}
async function watchSettingsDeployment(sha,attempt=0){
 try{
  const response=await fetch("/api/admin/deployment-status/?sha="+encodeURIComponent(sha),{credentials:"same-origin",cache:"no-store"});
  if(response.status===401){goLogin();return}
  const data=await response.json().catch(()=>({error:"无法读取部署状态"}));
  if(!response.ok)throw new Error(data.error||"无法查询部署状态");
  if(data.status==="success"){ $("settingsStatus").textContent="配置已保存，正式网站部署成功。";$("settingsStatus").style.color="#12884f";return }
  if(data.status==="failure"){ $("settingsStatus").textContent="配置已写入 GitHub，但部署失败，请查看工作流日志。";$("settingsStatus").style.color="#b42318";return }
  if(attempt>=20){$("settingsStatus").textContent="配置已保存到 GitHub，部署仍未确认；可稍后检查 Actions。";return}
  $("settingsStatus").textContent="配置已保存，正在等待正式网站构建与部署…";
  setTimeout(()=>watchSettingsDeployment(sha,attempt+1),12000);
 }catch(error){
  if(attempt>=20){$("settingsStatus").textContent="配置已保存，但暂时无法确认部署状态："+(error instanceof Error?error.message:"未知错误");return}
  setTimeout(()=>watchSettingsDeployment(sha,attempt+1),12000);
 }
}
$("settingsForm").addEventListener("submit",async event=>{
 event.preventDefault();
 const button=$("saveSettings");const status=$("settingsStatus");
 const values={backgroundImage:$("backgroundImage").value.trim(),backgroundMusic:$("backgroundMusic").value.trim(),bio:$("bio").value};
 if(values.backgroundImage&&!checkedExternalUrl(values.backgroundImage)){status.textContent="背景图片请填写完整的 HTTP/HTTPS 链接。";status.style.color="#b42318";return}
 if(values.backgroundMusic&&!checkedExternalUrl(values.backgroundMusic)){status.textContent="背景音乐请填写完整的 HTTP/HTTPS 音频链接。";status.style.color="#b42318";return}
 button.disabled=true;status.style.color="#657267";status.textContent="正在保存到 GitHub…";
 try{
  const response=await fetch("/api/admin/settings/",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify(values)});
  if(response.status===401){goLogin();return}
  const data=await response.json().catch(()=>({error:"保存接口返回无法解析的响应"}));
  if(!response.ok)throw new Error(data.error||"保存全局配置失败");
  status.textContent="配置已写入 GitHub，正在触发部署…";
  if(data.commitSha)watchSettingsDeployment(data.commitSha);
  else status.textContent="配置已保存，但接口未返回提交号，暂时无法跟踪部署。";
 }catch(error){
  status.textContent=error instanceof Error?error.message:"保存全局配置失败。";status.style.color="#b42318";
 }finally{button.disabled=false}
});

$("checkGitHub").onclick=checkGitHubPermission;
$("logout").onclick=async()=>{try{const r=await fetch("/api/admin/auth/",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});if(!r.ok)throw new Error("退出登录失败，请刷新后重试");location.assign("/admin/login/")}catch(e){say(e.message,true)}};
$("new").onclick=()=>{location.assign("/admin/new/")};$("reset").onclick=reset;$("refresh").onclick=refresh;$("search").oninput=render;$("statusFilter").onchange=render;
$("editorTab").onclick=showEditorTab;$("previewTab").onclick=renderMarkdownPreview;$("body").addEventListener("input",()=>{if(!$("markdownPreview").hidden)renderMarkdownPreview()});
$("editor").onsubmit=async e=>{e.preventDefault();const mode=e.submitter?.value==="publish"?"publish":"draft";if(mode==="publish"&&!confirm("发布文章将写入 GitHub 并触发 Cloudflare 部署，确定发布吗？"))return;const isDraft=mode==="draft";$("draft").checked=isDraft;const metadata={title:$("title").value.trim(),published:$("published").value,category:$("category").value,description:$("description").value,tags:$("tags").value.split(",").map(x=>x.trim()).filter(Boolean),draft:isDraft};const data=selected?{path:selected.path,sha:selected.sha,rawContent:$("body").value,...metadata}:{...metadata,slug:$("slug").value,body:$("body").value};const buttons=[$("saveDraft"),$("publish")];buttons.forEach(b=>b.disabled=true);try{const result=await api(selected?"PUT":"POST",data);reset();await refresh();if(isDraft){say("草稿已写入 GitHub；它保持草稿状态。")}else if(result.commitSha){say("文章已写入 GitHub，正在跟踪 Cloudflare 部署…");watchDeployment(result.commitSha)}else{say("文章已写入 GitHub，但接口未返回提交号，无法自动确认部署。",true)}}catch(err){say(err.message,true)}finally{buttons.forEach(b=>b.disabled=false)}};
$("delete").onclick=async()=>{if(!selected||!confirm("确定删除 "+selected.title+"？此操作会提交到 GitHub。"))return;$("delete").disabled=true;try{await api("DELETE",{path:selected.path,sha:selected.sha});say("文章已删除");reset();await refresh()}catch(e){say(e.message,true)}finally{$("delete").disabled=false}};
reset();refresh();loadSettings();
</script></body></html>
