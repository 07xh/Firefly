---
export const prerender = false;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>文章管理 · Firefly</title>
<style>
:root{font-family:system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;color:#202820;background:#f3f6f3}*{box-sizing:border-box}body{margin:0}header{padding:16px max(18px,calc((100vw - 1100px)/2));background:white;border-bottom:1px solid #e1e8e1;display:flex;justify-content:space-between;align-items:center}h1{font-size:19px;margin:0}.wrap{max-width:1100px;margin:26px auto;padding:0 16px;display:grid;grid-template-columns:320px minmax(0,1fr);gap:18px}.panel{background:white;border:1px solid #e0e7e0;border-radius:14px;padding:18px;min-width:0}.btn{border:1px solid #d5dfd5;border-radius:8px;background:white;color:#263329;padding:9px 12px;cursor:pointer}.primary{background:#12884f;color:white;border-color:#12884f}.danger{color:#b42318}.toolbar{display:flex;gap:8px;margin-bottom:12px}.toolbar input{min-width:0;flex:1}.field{display:grid;gap:6px;margin-bottom:13px}.field label{font-size:12px;color:#59675d;font-weight:650}.field input,.field textarea,.toolbar input{width:100%;border:1px solid #d8e1d8;border-radius:8px;padding:10px;font:inherit;background:white;color:#202820}.field textarea{min-height:240px;resize:vertical;font-family:ui-monospace,monospace;line-height:1.6}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.item{width:100%;display:block;text-align:left;background:white;border:1px solid #e3e9e3;border-radius:9px;padding:11px;margin-bottom:8px;cursor:pointer;color:inherit}.item strong,.item small{display:block;overflow-wrap:anywhere}.item strong{font-size:13px}.item small,.muted{color:#718075;font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap}.status{min-height:20px;font-size:12px;margin-top:12px;color:#657267;overflow-wrap:anywhere}.check{display:flex;gap:8px;align-items:center;font-size:13px;margin:12px 0}.empty{color:#758077;font-size:13px;line-height:1.7}.editor-tabs{display:flex;gap:8px;margin:2px 0 9px}.editor-tabs .active{background:#eaf6ee;border-color:#b6dbc3;color:#127947}.markdown-preview{min-height:240px;border:1px solid #d8e1d8;border-radius:8px;padding:14px;line-height:1.75;overflow-wrap:anywhere;color:#202820}.markdown-preview h1,.markdown-preview h2,.markdown-preview h3{line-height:1.35;margin:1.1em 0 .6em}.markdown-preview p,.markdown-preview ul,.markdown-preview ol,.markdown-preview blockquote{margin:.65em 0}.markdown-preview pre{overflow:auto;background:#f3f6f3;padding:12px;border-radius:8px}.markdown-preview code{font-family:ui-monospace,monospace;background:#f3f6f3;padding:2px 4px;border-radius:4px}.markdown-preview pre code{padding:0}.markdown-preview img{max-width:100%;height:auto}.markdown-preview table{border-collapse:collapse;max-width:100%;display:block;overflow:auto}.markdown-preview th,.markdown-preview td{border:1px solid #d8e1d8;padding:6px 9px}.markdown-preview blockquote{border-left:3px solid #b6dbc3;padding-left:12px;color:#59675d}.deploy-link{display:inline-block;margin-top:7px;color:#12884f;font-size:12px}.actions .btn{min-width:100px}@media(max-width:720px){.wrap{grid-template-columns:1fr;margin-top:12px}.grid{grid-template-columns:1fr}.list{max-height:260px;overflow:auto}header{padding:13px 15px}}
</style></head>
<body>
<header><h1>✦ Firefly 文章管理</h1><a href="/" style="color:#16864f;font-size:13px">返回网站 ↗</a></header>
<main class="wrap">
<section class="panel"><div class="toolbar"><input id="search" placeholder="搜索文章…" aria-label="搜索文章"><button class="btn" id="refresh">刷新</button></div><button class="btn primary" id="new" style="width:100%;margin-bottom:12px">＋ 新建文章</button><div id="list" class="list"><p class="empty">正在读取文章列表…</p></div></section>
<section class="panel"><h2 id="formTitle" style="font-size:16px;margin:0 0 16px">新建文章</h2><form id="editor">
<div class="field"><label for="title">标题 *</label><input id="title" required maxlength="200"></div>
<div class="grid"><div class="field"><label for="slug">文件名 *</label><input id="slug" required pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,79}" placeholder="my-post"></div><div class="field"><label for="published">发布日期 *</label><input id="published" type="date" required></div></div>
<div class="grid"><div class="field"><label for="category">分类</label><input id="category" maxlength="100"></div><div class="field"><label for="tags">标签（逗号分隔）</label><input id="tags" placeholder="技术, 随笔"></div></div>
<div class="field"><label for="description">摘要</label><input id="description" maxlength="500"></div>
<div class="field"><label for="body">正文 Markdown / 已有文章完整源文件</label><div class="editor-tabs"><button class="btn active" type="button" id="editorTab">编辑</button><button class="btn" type="button" id="previewTab">Markdown 预览</button></div><textarea id="body" spellcheck="false" placeholder="新建时填写正文；编辑已有文章时这里会显示完整 Markdown/MDX 源文件，保留全部 frontmatter 元数据。"></textarea><div id="markdownPreview" class="markdown-preview" hidden><p class="muted">点击“Markdown 预览”查看排版效果。</p></div></div>
<label class="check"><input id="draft" type="checkbox" disabled> 当前为草稿状态（由上方操作按钮决定）</label>
<div class="actions"><button class="btn" type="submit" id="saveDraft" value="draft">保存草稿</button><button class="btn primary" type="submit" id="publish" value="publish">发布文章</button><button class="btn danger" type="button" id="delete" disabled title="请先从左侧选择一篇已有文章">删除文章</button><button class="btn" type="button" id="reset">清空表单</button></div>
</form><div class="status" id="status" role="status" aria-live="polite"></div><p class="muted">保存草稿会将文章写入 GitHub 并触发构建，但保持草稿状态；发布文章会将 draft 设为 false，提交到 GitHub，并跟踪 Cloudflare 部署结果。</p><a id="deployLink" class="deploy-link" href="#" target="_blank" rel="noopener noreferrer" hidden>查看 Cloudflare 部署日志 ↗</a></section>
</main>
<script>
// @ts-nocheck
const $=id=>document.getElementById(id);let articles=[],selected=null;
function say(s,bad=false){$("status").textContent=s;$("status").style.color=bad?"#b42318":"#657267"}
async function api(method,data){const r=await fetch("/api/admin/articles",{method,headers:{"Content-Type":"application/json"},...(data?{body:JSON.stringify(data)}:{})});const d=await r.json().catch(()=>({error:"服务器响应无法解析"}));if(!r.ok)throw new Error(d.error||"请求失败");return d}
function render(){const q=$("search").value.trim().toLowerCase();$("list").replaceChildren();const items=articles.filter(a=>a.title.toLowerCase().includes(q)||a.path.toLowerCase().includes(q));if(!items.length){const p=document.createElement("p");p.className="empty";p.textContent="没有找到文章";$("list").append(p);return}for(const a of items){const b=document.createElement("button");b.className="item";const t=document.createElement("strong");t.textContent=a.title;const m=document.createElement("small");m.textContent=(a.published||"无日期")+(a.draft?" · 草稿":"")+" · "+a.path;b.append(t,m);b.onclick=()=>{selected=a;$("formTitle").textContent="编辑文章源文件";$("slug").value=a.path.split("/").pop().replace(/\.mdx?$/,"");$("slug").disabled=true;$("title").value=a.title;$("published").value=a.published;$("draft").checked=a.draft;$("body").value=a.content||"";$("delete").disabled=false;say(a.content?"已载入完整源文件；保存会保留未修改的元数据。":"未能载入文章内容，请刷新后重试。",!a.content);$("editor").scrollIntoView({behavior:"smooth",block:"start"})};$("list").append(b)}}
async function refresh(){try{say("正在读取 GitHub…");articles=await api("GET");render();say("已读取 "+articles.length+" 篇文章")}catch(e){say(e.message,true);$("list").textContent="读取失败，请确认服务端令牌和仓库权限已配置。"}}
function reset(){selected=null;$("editor").reset();$("slug").disabled=false;$("published").value=new Date().toISOString().slice(0,10);$("formTitle").textContent="新建文章";$("delete").disabled=true;showEditorTab();$("deployLink").hidden=true;$("deployLink").removeAttribute("href")}
function showEditorTab(){$("body").hidden=false;$("markdownPreview").hidden=true;$("editorTab").classList.add("active");$("previewTab").classList.remove("active")}
function showPreviewTab(){$("body").hidden=true;$("markdownPreview").hidden=false;$("editorTab").classList.remove("active");$("previewTab").classList.add("active")}
async function renderMarkdownPreview(){showPreviewTab();$("markdownPreview").innerHTML="<p class=muted>正在生成预览…</p>";try{const r=await fetch("/api/admin/preview",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({markdown:$("body").value})});const d=await r.json().catch(()=>({error:"预览响应无法解析"}));if(!r.ok)throw new Error(d.error||"Markdown 预览失败");$("markdownPreview").innerHTML=d.html||"<p class=muted>暂无内容</p>"}catch(e){$("markdownPreview").textContent=e.message}}
async function watchDeployment(sha,attempt=0){try{const r=await fetch("/api/admin/deployment-status?sha="+encodeURIComponent(sha),{cache:"no-store"});const d=await r.json().catch(()=>({error:"无法读取部署状态"}));if(!r.ok)throw new Error(d.error||"暂时无法查询部署状态");if(d.url){$("deployLink").href=d.url;$("deployLink").hidden=false}if(d.status==="success"){say("Cloudflare 部署成功，正式网站已更新。");return}if(d.status==="failure"){say("Cloudflare 部署失败，请打开部署日志检查。",true);return}if(attempt>=24){say("文章已提交到 GitHub，但部署仍未确认；可查看最新工作流日志。");return}say(d.status==="running"?"文章已提交，Cloudflare 正在构建/部署…":"文章已提交，正在等待 Cloudflare 部署启动…");setTimeout(()=>watchDeployment(sha,attempt+1),12000)}catch(e){if(attempt>=24){say("文章已提交到 GitHub，但仍无法确认部署状态："+e.message,true);return}say("正在查询 Cloudflare 部署状态…");setTimeout(()=>watchDeployment(sha,attempt+1),12000)}}
$("new").onclick=()=>{reset();$("editor").scrollIntoView({behavior:"smooth",block:"start"});$("title").focus({preventScroll:true});say("新建文章：请填写标题和正文")};$("reset").onclick=reset;$("refresh").onclick=refresh;$("search").oninput=render;
$("editorTab").onclick=showEditorTab;$("previewTab").onclick=renderMarkdownPreview;$("body").addEventListener("input",()=>{if(!$("markdownPreview").hidden)renderMarkdownPreview()});
$("editor").onsubmit=async e=>{e.preventDefault();const mode=e.submitter?.value==="publish"?"publish":"draft";if(mode==="publish"&&!confirm("发布文章将写入 GitHub 并触发 Cloudflare 部署，确定发布吗？"))return;const isDraft=mode==="draft";$("draft").checked=isDraft;const data=selected?{path:selected.path,sha:selected.sha,rawContent:$("body").value,draft:isDraft}:{title:$("title").value,slug:$("slug").value,published:$("published").value,category:$("category").value,description:$("description").value,tags:$("tags").value.split(",").map(x=>x.trim()).filter(Boolean),draft:isDraft,body:$("body").value};const buttons=[$("saveDraft"),$("publish")];buttons.forEach(b=>b.disabled=true);try{const result=await api(selected?"PUT":"POST",data);reset();await refresh();if(isDraft){say("草稿已写入 GitHub；它保持草稿状态。")}else if(result.commitSha){say("文章已写入 GitHub，正在跟踪 Cloudflare 部署…");watchDeployment(result.commitSha)}else{say("文章已写入 GitHub，但接口未返回提交号，无法自动确认部署。",true)}}catch(err){say(err.message,true)}finally{buttons.forEach(b=>b.disabled=false)}};
$("delete").onclick=async()=>{if(!selected||!confirm("确定删除 "+selected.title+"？此操作会提交到 GitHub。"))return;$("delete").disabled=true;try{await api("DELETE",{path:selected.path,sha:selected.sha});say("文章已删除");reset();await refresh()}catch(e){say(e.message,true)}finally{$("delete").disabled=false}};
reset();refresh();
</script></body></html>
