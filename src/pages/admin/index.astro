<script>
// @ts-nocheck
import katex from "katex";
import "katex/dist/katex.min.css";
Object.assign(window, { FireflyKatex: katex });
window.dispatchEvent(new Event("firefly:katex-ready"));
const $ = id => document.getElementById(id);
let articles = [], selected = null;
Object.defineProperty(window, "FireflyArticleContext", {
  configurable: true,
  get() {
    return selected
      ? { path: selected.path || "", sha: selected.sha || "" }
      : { path: "", sha: "" };
  }
});
let settingsReady = false;
let settingsSaving = false;
let savedSettingsSnapshot = "";
let articleBaseline = "";
let allowAdminNavigation = false;

function currentSettingsSnapshot() {
  return JSON.stringify(Array.from($("settingsForm").querySelectorAll("input[name], textarea[name], select[name]"))
    .map(field => [field.name, field.type === "checkbox" ? field.checked : field.value]));
}
function isSettingsDirty() {
  return settingsReady && currentSettingsSnapshot() !== savedSettingsSnapshot;
}
function updateSettingsDirtyState() {
  const dirty = isSettingsDirty();
  const state = $("settingsDirtyState");
  state.dataset.dirty = String(dirty);
  state.textContent = !settingsReady ? "配置尚未加载" : dirty ? "有未保存的修改" : "所有修改均已保存";
  $("discardSettings").disabled = !dirty || settingsSaving;
  $("saveSettings").disabled = !settingsReady || settingsSaving;
  return dirty;
}
function markSettingsSaved() {
  savedSettingsSnapshot = currentSettingsSnapshot();
  settingsReady = true;
  updateSettingsDirtyState();
}
function currentArticleSnapshot() {
  return JSON.stringify(["title", "slug", "published", "date", "articlePassword", "passwordHint", "category", "tags", "description", "body"]
    .map(id => [id, $(id).value]).concat([["draft", $("draft").checked]]));
}
function isArticleDirty() {
  return articleBaseline !== "" && currentArticleSnapshot() !== articleBaseline;
}
function updateArticleDirtyState() {
  const dirty = isArticleDirty();
  $("formTitle").textContent = selected
    ? (dirty ? "编辑文章 · 未保存修改" : "编辑文章")
    : (dirty ? "新建文章 · 未保存修改" : "新建文章");
  return dirty;
}
function hasUnsavedChanges() {
  return isArticleDirty() || isSettingsDirty();
}
function goLogin() {
  allowAdminNavigation = true;
  location.assign("/admin/login/?next=" + encodeURIComponent(location.pathname + location.search));
}
window.addEventListener("beforeunload", event => {
  if (!allowAdminNavigation && hasUnsavedChanges()) {
    event.preventDefault();
    event.returnValue = "";
  }
});

function say(s,bad=false){$("status").textContent=s;$("status").style.color=bad?"#b42318":"#657267"}
function todayInBeijing() {
 const parts = new Intl.DateTimeFormat("en-CA", { timeZone:"Asia/Shanghai", year:"numeric", month:"2-digit", day:"2-digit" }).formatToParts(new Date());
 const values = Object.fromEntries(parts.map(part => [part.type, part.value]));
 return values.year + "-" + values.month + "-" + values.day;
}
function toBeijingDateTimeLocal(value) {
 if (!value) return "";
 const date = new Date(value);
 if (Number.isNaN(date.getTime())) return "";
 const parts = new Intl.DateTimeFormat("en-CA", { timeZone:"Asia/Shanghai", year:"numeric", month:"2-digit", day:"2-digit", hour:"2-digit", minute:"2-digit", hourCycle:"h23" }).formatToParts(date);
 const values = Object.fromEntries(parts.map(part => [part.type, part.value]));
 return values.year + "-" + values.month + "-" + values.day + "T" + values.hour + ":" + values.minute;
}
function fromBeijingDateTimeLocal(value) {
 if (!value) return "";
 const iso = value + ":00+08:00";
 return Number.isFinite(Date.parse(iso)) ? iso : "";
}
function articleStatus(article) {
 if (article.draft === true) return "draft";
 const raw = article.date || frontmatterValue(article.content || "", "date");
 const timestamp = raw ? Date.parse(raw) : Number.NaN;
 return Number.isFinite(timestamp) && timestamp > Date.now() ? "scheduled" : "published";
}
function updateSaveButtonLabel() {
 const draft = $("draft").checked;
 const localDate = $("date").value;
 const hasFutureDate = Boolean(localDate && Date.parse(localDate + ":00+08:00") > Date.now());
 $("saveDraft").textContent = draft ? "保存为草稿" : (hasFutureDate ? "保存定时文章" : (selected ? "保存修改" : "保存并公开"));
}
function frontmatterValue(source,key){const match=source.match(new RegExp("^"+key+":\\s*(.*?)\\s*$","m"));if(!match)return "";const raw=match[1].trim();try{const parsed=JSON.parse(raw);if(Array.isArray(parsed))return parsed.map(String).join(", ");if(typeof parsed==="string")return parsed;if(parsed===null)return ""}catch{}if(raw.startsWith("'")&&raw.endsWith("'"))return raw.slice(1,-1).replace(/''/g,"'");return raw}
async function api(method,data){const r=await fetch("/api/admin/articles/",{method,headers:{"Content-Type":"application/json"},...(data?{body:JSON.stringify(data)}:{})});if(r.status===401){goLogin();throw new Error("登录已过期，正在跳转登录页…")}const d=await r.json().catch(()=>({error:"服务器响应无法解析"}));if(!r.ok)throw new Error(d.error||"请求失败");return d}
function render(){
 const q=$("search").value.trim().toLowerCase();
 const statusFilter=$("statusFilter").value;
 const list=$("list");
 list.replaceChildren();

 const items=articles.filter(a=>
  ((a.title||"").toLowerCase().includes(q)||(a.path||"").toLowerCase().includes(q)) &&
  (statusFilter==="all"||articleStatus(a)===statusFilter)
 );

 if(!items.length){
  const empty=document.createElement("p");
  empty.className="rounded-lg px-3 py-8 text-center text-sm text-gray-400";
  empty.textContent="没有找到文章";
  list.append(empty);
  return;
 }

 for(const a of items){
  const isActive=selected?.path===a.path;
  const row=document.createElement("div");
  row.className=[
   "group relative flex min-w-0 items-center gap-1 rounded-r-lg border-l-4 transition-colors duration-150",
   isActive
    ? "border-emerald-500 bg-emerald-50/60"
    : "border-transparent hover:bg-gray-50"
  ].join(" ");

  const item=document.createElement("button");
  item.type="button";
  item.className=[
   "min-w-0 flex-1 rounded-r-lg px-3 py-3 text-left",
   "focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-emerald-500/30"
  ].join(" ");

  const titleRow=document.createElement("span");
  titleRow.className="block truncate text-sm font-semibold text-gray-800";
  titleRow.textContent=a.title||"未命名文章";

  const pathRow=document.createElement("span");
  pathRow.className="mt-1 block truncate text-xs font-normal text-gray-400";
  pathRow.textContent=a.path + " · " + ({draft:"草稿箱",scheduled:"定时发布",published:"已发布"}[articleStatus(a)]);

  item.append(titleRow,pathRow);

  item.onclick=()=>{
   if(isArticleDirty()&&!confirm("当前文章有未保存修改，切换文章会丢失这些内容。是否继续？"))return;
   selected=a;
   $("formTitle").textContent="编辑文章";
   $("slug").value=a.path.split("/").pop().replace(/\.mdx?$/,"");
   $("slug").disabled=true;
   $("body").value=a.content||"";
   window.dispatchEvent(new CustomEvent("firefly:source-loaded"));
   $("title").value=frontmatterValue(a.content||"","title")||a.title;
   $("published").value=frontmatterValue(a.content||"","published")||a.published;
   $("date").value=toBeijingDateTimeLocal(frontmatterValue(a.content||"","date"));
   $("articlePassword").value=frontmatterValue(a.content||"","password");
   $("passwordHint").value=frontmatterValue(a.content||"","passwordHint");
   $("category").value=frontmatterValue(a.content||"","category");
   $("description").value=frontmatterValue(a.content||"","description");
   $("tags").value=frontmatterValue(a.content||"","tags");
   $("draft").checked=a.draft;
   updateSaveButtonLabel();
   articleBaseline=currentArticleSnapshot();
   updateArticleDirtyState();
   $("saveDraft").textContent=a.draft?"保存草稿修改":"转为草稿";
   $("publish").textContent=a.draft?"发布这篇文章":"保存修改并发布";
   $("delete").disabled=false;
   say(
    a.content
     ?"已载入文章。日期、定时发布时间、密码保护、分类、摘要和标签均可在表单中修改。"
     :"未能载入文章内容，请刷新后重试。",
    !a.content
   );
   showVisualTab();
   render();
   $("editor").scrollIntoView({behavior:"smooth",block:"start"});
  };

  const del=document.createElement("button");
  del.type="button";
  del.textContent="删除";
  del.setAttribute("aria-label","删除文章："+a.title);
  del.className=[
   "mr-1 shrink-0 rounded-md px-2.5 py-2 text-xs font-medium text-rose-600 transition-colors",
   "hover:bg-rose-50 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500/40",
   "opacity-100 sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100"
  ].join(" ");

  del.onclick=async event=>{
   event.stopPropagation();
   if(!confirm("确定删除“"+a.title+"”？此操作会提交到 GitHub 并触发部署。"))return;
   del.disabled=true;
   try{
    await api("DELETE",{path:a.path,sha:a.sha});
    if(selected&&selected.path===a.path)reset();
    say("文章已删除，正在刷新列表…");
    await refresh();
   }catch(e){
    say(e.message,true);
   }finally{
    del.disabled=false;
   }
  };

  row.append(item,del);
  list.append(row);
 }
}
