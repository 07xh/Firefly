  font-size:11px;
  line-height:1.5;
}
@media(max-width:640px) {
  .editor-reading-controls { gap:6px; padding:8px; }
  .editor-reading-controls__hint { flex:1 0 100%; margin-left:0; }
  .editor-reading-controls button { min-height:40px; min-width:40px; }
}

#aiProvidersTabPanel[hidden]{display:none!important}
