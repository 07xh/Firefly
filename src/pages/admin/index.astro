  $("showEmail").checked=data.showEmail===true;
  $("showSupportAndShare").checked=data.showSupportAndShare===true;
  $("showSourceGithub").checked=data.showSourceGithub===true;
  const savedLayout = data.layoutSettings && typeof data.layoutSettings === "object" ? data.layoutSettings : {};
  $("layoutSidebarEnabled").checked=savedLayout.sidebarEnabled!==false;
  $("layoutSidebarPosition").value=["left","right","both"].includes(savedLayout.sidebarPosition)?savedLayout.sidebarPosition:"both";
  $("layoutTabletSidebar").value=["left","right"].includes(savedLayout.tabletSidebar)?savedLayout.tabletSidebar:"left";
  $("layoutPostListMode").value=["list","grid"].includes(savedLayout.postListMode)?savedLayout.postListMode:"list";
  $("layoutMobilePostListMode").value=["list","grid"].includes(savedLayout.mobilePostListMode)?savedLayout.mobilePostListMode:"grid";
  $("layoutCoverPosition").value=["left","right"].includes(savedLayout.coverPosition)?savedLayout.coverPosition:"right";
  $("layoutGridMasonry").checked=savedLayout.gridMasonry===true;
  $("layoutGridColumnWidth").value=Number.isInteger(savedLayout.gridColumnWidth)&&savedLayout.gridColumnWidth>=220&&savedLayout.gridColumnWidth<=460?savedLayout.gridColumnWidth:320;
  $("layoutGridCoverFullWidth").checked=savedLayout.gridCoverFullWidth===true;
  $("showAbout").checked=data.showAbout!==false;
  $("showAboutDonation").checked=data.showAboutDonation===true;
  $("showNavSocial").checked=data.showNavSocial!==false;
  $("showNavMy").checked=data.showNavMy!==false;
