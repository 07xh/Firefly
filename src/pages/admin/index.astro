<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>管理后台 · Firefly</title>
<style>
:root{font-family:system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;color:#202820;background:#f3f6f3}*{box-sizing:border-box}body{margin:0}header{padding:16px max(18px,calc((100vw - 1100px)/2));background:white;border-bottom:1px solid #e1e8e1;display:flex;justify-content:space-between;align-items:center}h1{font-size:19px;margin:0}.wrap{max-width:1100px;margin:18px auto 26px;padding:0 16px}.articles-grid{display:grid;grid-template-columns:320px minmax(0,1fr);gap:18px}.admin-tabs{max-width:1100px;margin:20px auto 0;padding:0 16px;display:flex;gap:8px;border-bottom:1px solid #e3eae4}.admin-tab{border:1px solid transparent;border-bottom:0;border-radius:10px 10px 0 0;padding:10px 14px;background:transparent;color:#718075;cursor:pointer;font:inherit;font-size:13px;transition:background .15s,color .15s,border-color .15s}.admin-tab:hover{background:#f7faf7;color:#16834c}.admin-tab[aria-selected=true]{border-color:#d8e9dd;background:white;color:#12884f;font-weight:650;box-shadow:0 -1px 0 #fff inset}#articlesTabPanel[hidden],#appearanceTabPanel[hidden]{display:none!important}.settings-panel{max-width:900px;margin:0 auto}.settings-cards{display:grid;gap:16px}.settings-card{background:#fff;border:1px solid #e2eae3;border-radius:16px;padding:20px;box-shadow:0 3px 12px #173c2510;min-width:0}.settings-card-heading{display:flex;align-items:flex-start;gap:12px;margin-bottom:18px}.settings-card-number{display:inline-flex;align-items:center;justify-content:center;flex:0 0 34px;height:34px;border-radius:11px;background:#eaf7ef;color:#16834c;font-size:12px;font-weight:800;letter-spacing:.04em}.settings-card-heading h3{margin:1px 0 4px;font-size:15px;font-weight:750;color:#26372b}.settings-card-heading p{margin:0;color:#79867c;font-size:12px;line-height:1.6}.settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 16px}.settings-grid-one{grid-template-columns:minmax(0,1fr)}.settings-field{display:grid;gap:7px;min-width:0;margin:0}.settings-field>label{font-size:13px;color:#334155;font-weight:650}.settings-field>small{color:#718075;font-size:12px;line-height:1.6}.settings-control{width:100%;min-width:0;border:1px solid #d8e1d8;border-radius:11px;padding:11px 13px;font:inherit;font-size:13px;background:#fff;color:#202820;transition:border-color .15s,box-shadow .15s}.settings-control:hover{border-color:#c2d3c5}.settings-control:focus{border-color:#10b981;outline:none;box-shadow:0 0 0 3px #10b98122}textarea.settings-control{resize:vertical;min-height:100px;line-height:1.7}#bio{min-height:100px}#announcement{min-height:120px}.settings-preview{display:flex;align-items:center;gap:12px;min-height:74px;padding:10px;border:1px solid #edf1ed;border-radius:12px;background:#f8faf8;overflow:hidden}.settings-preview img{width:100px;height:64px;object-fit:cover;border-radius:8px;background:#eef2ee;flex:0 0 auto}.settings-preview.is-avatar img{width:64px;height:64px;border-radius:50%;object-fit:cover}.settings-preview-note{font-size:12px;color:#8b968e;line-height:1.6}.settings-toggle{position:relative;display:flex;align-items:center;gap:10px;min-height:42px;padding:9px 12px;border:1px solid #e4ebe5;border-radius:11px;background:#fafcfa;cursor:pointer}.settings-toggle input{position:absolute;width:1px;height:1px;opacity:0}.settings-toggle-track{position:relative;display:inline-block;flex:0 0 36px;width:36px;height:21px;border-radius:999px;background:#cbd5ce;transition:background .18s}.settings-toggle-track:before{content:"";position:absolute;left:3px;top:3px;width:15px;height:15px;border-radius:50%;background:#fff;box-shadow:0 1px 2px #0002;transition:transform .18s}.settings-toggle input:checked+.settings-toggle-track{background:#16a064}.settings-toggle input:checked+.settings-toggle-track:before{transform:translateX(15px)}.settings-toggle input:focus-visible+.settings-toggle-track{outline:3px solid #10b98144;outline-offset:3px}.settings-toggle-label{font-size:12px;font-weight:650;color:#47574b}.settings-toggle small{display:block;font-size:11px;font-weight:400;color:#89958c;margin-top:2px}.settings-switch-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.settings-color-row{display:grid;grid-template-columns:54px minmax(0,1fr);gap:10px;align-items:center}.settings-color-picker{width:54px;height:44px;padding:4px;border:1px solid #d8e1d8;border-radius:11px;background:#fff;cursor:pointer}.settings-save-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:4px 2px 10px}.settings-save-button{border:0;border-radius:11px;background:linear-gradient(135deg,#15965a,#087a43);color:#fff;padding:12px 18px;font:inherit;font-size:13px;font-weight:750;box-shadow:0 5px 12px #0d894b26;cursor:pointer;transition:transform .15s,opacity .15s}.settings-save-button:hover{transform:translateY(-1px)}.settings-save-button:disabled{opacity:.6;cursor:wait;transform:none}.settings-status{font-size:12px;color:#657267;line-height:1.6;overflow-wrap:anywhere}.admin-tab:focus-visible{outline:2px solid #10b981;outline-offset:2px}.panel{background:white;border:1px solid #e0e7e0;border-radius:14px;padding:18px;min-width:0}.btn{border:1px solid #d5dfd5;border-radius:8px;background:white;color:#263329;padding:9px 12px;cursor:pointer}.primary{background:#12884f;color:white;border-color:#12884f}.danger{color:#b42318}.toolbar{display:flex;gap:8px;margin-bottom:12px}.toolbar input{min-width:0;flex:1}.toolbar select{max-width:100px;border:1px solid #d8e1d8;border-radius:8px;padding:8px 5px;background:white;color:#263329;font:inherit;font-size:12px}.field{display:grid;gap:6px;margin-bottom:13px}.field label{font-size:12px;color:#59675d;font-weight:650}.field input,.field textarea,.toolbar input{width:100%;border:1px solid #d8e1d8;border-radius:8px;padding:10px;font:inherit;background:white;color:#202820}.field textarea{min-height:240px;resize:vertical;font-family:ui-monospace,monospace;line-height:1.6}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.item{width:100%;display:block;text-align:left;background:white;border:1px solid #e3e9e3;border-radius:9px;padding:11px;margin-bottom:8px;cursor:pointer;color:inherit}.article-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;margin-bottom:8px;align-items:stretch}.article-row .item{margin:0}.article-delete{border:1px solid #f1c6c3;border-radius:8px;background:#fff8f7;color:#b42318;padding:8px;cursor:pointer;min-width:48px}.article-delete:disabled{opacity:.55;cursor:wait}.item strong,.item small{display:block;overflow-wrap:anywhere}.item strong{font-size:13px}.item small,.muted{color:#718075;font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap}.status{min-height:20px;font-size:12px;margin-top:12px;color:#657267;overflow-wrap:anywhere}.check{display:flex;gap:8px;align-items:center;font-size:13px;margin:12px 0}.empty{color:#758077;font-size:13px;line-height:1.7}.editor-tabs{display:flex;gap:8px;margin:2px 0 9px}.editor-tabs .active{background:#eaf6ee;border-color:#b6dbc3;color:#127947}.markdown-preview{min-height:240px;border:1px solid #d8e1d8;border-radius:8px;padding:14px;line-height:1.75;overflow-wrap:anywhere;color:#202820}.markdown-preview h1,.markdown-preview h2,.markdown-preview h3{line-height:1.35;margin:1.1em 0 .6em}.markdown-preview p,.markdown-preview ul,.markdown-preview ol,.markdown-preview blockquote{margin:.65em 0}.markdown-preview pre{overflow:auto;background:#f3f6f3;padding:12px;border-radius:8px}.markdown-preview code{font-family:ui-monospace,monospace;background:#f3f6f3;padding:2px 4px;border-radius:4px}.markdown-preview pre code{padding:0}.markdown-preview img{max-width:100%;height:auto}.markdown-preview table{border-collapse:collapse;max-width:100%;display:block;overflow:auto}.markdown-preview th,.markdown-preview td{border:1px solid #d8e1d8;padding:6px 9px}.markdown-preview blockquote{border-left:3px solid #b6dbc3;padding-left:12px;color:#59675d}.deploy-link{display:inline-block;margin-top:7px;color:#12884f;font-size:12px}.actions .btn{min-width:100px}@media(max-width:720px){.wrap{margin-top:12px}.articles-grid{grid-template-columns:1fr}.admin-tabs{margin-top:12px;padding:0 12px}.admin-tab{padding:10px 9px;font-size:12px}.settings-panel{padding:16px}.grid{grid-template-columns:1fr}.list{max-height:260px;overflow:auto}header{padding:13px 15px}}

/* Responsive, safe editing controls added during the admin UX pass. */
.settings-save-row {
  position: sticky;
  bottom: 8px;
  z-index: 20;
  gap: 10px;
  margin-top: 6px;
  padding: 12px;
  border: 1px solid #dce8de;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -6px 24px rgba(22, 64, 35, 0.09);
  backdrop-filter: blur(14px);
}
.settings-dirty-state {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 10px;
  border-radius: 999px;
  background: #edf7ef;
  color: #167848;
  font-size: 12px;
  font-weight: 650;
  line-height: 1.5;
}
.settings-dirty-state::before {
  content: "";
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: #16a064;
}
.settings-dirty-state[data-dirty="true"] {
  background: #fff5e6;
  color: #925400;
}
.settings-dirty-state[data-dirty="true"]::before {
  background: #d97706;
}
#discardSettings {
  white-space: nowrap;
}
#discardSettings:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
#saveSettings:focus-visible, #discardSettings:focus-visible {
  outline: 3px solid #10b98155;
  outline-offset: 3px;
}
@media (max-width: 900px) {
  .settings-switch-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 720px) {
  .settings-grid, .settings-switch-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .settings-card {
    padding: 16px;
    border-radius: 14px;
  }
  .settings-card-heading {
    gap: 10px;
    margin-bottom: 14px;
  }
  .settings-save-row {
    bottom: 6px;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    padding: 10px;
  }
  .settings-save-row .settings-save-button, #discardSettings {
    width: 100%;
    min-height: 44px;
  }
  .settings-status {
    overflow-wrap: anywhere;
  }
  header {
    gap: 10px;
    flex-wrap: wrap;
  }
  header > div {
    gap: 8px !important;
  }
}
@media (max-width: 390px) {
  .settings-color-row {
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 8px;
  }
  .settings-color-picker {
    width: 44px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .settings-save-button, .settings-control, .settings-toggle-track,
  .settings-toggle-track::before, .admin-tab {
    transition: none !important;
  }
}


/* Tiptap-based WYSIWYG article editor */
.local-recovery-row { display:flex; align-items:center; flex-wrap:wrap; gap:9px; margin:0 0 10px; padding:10px 12px; border:1px solid #e2eae3; border-radius:10px; background:#f8fbf8; }
.local-recovery-toggle { display:inline-flex; align-items:center; gap:7px; color:#425248; font-size:12px; font-weight:650; cursor:pointer; }
.local-recovery-toggle input { width:16px; height:16px; accent-color:#12884f; }
.local-recovery-row #restoreLocalRecovery[hidden] { display:none!important; }
.local-recovery-row #localRecoveryStatus { flex:1 1 220px; min-width:0; line-height:1.6; }

.rich-editor-shell { border:1px solid #d8e1d8; border-radius:12px; overflow:hidden; background:#fff; }
.rich-editor-toolbar { display:flex; flex-wrap:wrap; gap:6px; align-items:center; padding:9px; border-bottom:1px solid #e6ece7; background:#f8fbf8; }
.rich-editor-toolbar button { min-height:36px; min-width:38px; border:1px solid #dce5dd; border-radius:8px; padding:6px 9px; background:#fff; color:#35443a; font-size:12px; cursor:pointer; }
.rich-editor-toolbar button:hover,.rich-editor-toolbar button.is-active { background:#e7f7ed; border-color:#8dc9a1; color:#087a43; }
.rich-editor-toolbar button:disabled { opacity:.55; cursor:wait; }
.rich-editor-toolbar .toolbar-divider { width:1px; height:25px; background:#dce5dd; margin:0 2px; }
.table-editor-tools { display:flex; flex-wrap:wrap; align-items:center; gap:5px; padding:3px 5px; border:1px solid #dce7de; border-radius:10px; background:#f0f7f1; }
.table-editor-tools[hidden] { display:none!important; }
.table-editor-tools button { min-height:32px; padding:5px 8px; font-size:11px; }
.table-editor-tools button[data-editor-action="deleteRow"],.table-editor-tools button[data-editor-action="deleteColumn"],.table-editor-tools button[data-editor-action="deleteTable"] { color:#9e2f2f; border-color:#ead0d0; }
@media(max-width:640px){.rich-editor-toolbar{gap:5px;padding:7px}.table-editor-tools{flex:1 1 100%;order:8}.table-editor-tools .toolbar-divider{display:none}.table-editor-tools button{flex:1 1 auto;min-width:72px}}
.rich-editor-canvas {
  min-height:360px;
  max-height:72vh;
  overflow:auto;
  padding:clamp(14px,2.2vw,26px);
  color:#26342a;
  background:#fff;
  scroll-behavior:smooth;
}
.firefly-prosemirror-content {
  min-height:320px;
  max-width:880px;
  margin-inline:auto;
  outline:none;
  color:#28352c;
  font-size:var(--firefly-reading-size,16px);
  line-height:1.92;
  overflow-wrap:anywhere;
  word-break:normal;
  -webkit-font-smoothing:antialiased;
}
.firefly-prosemirror-content::selection,
.firefly-prosemirror-content *::selection { background:#ccebd5; color:#203528; }
.firefly-prosemirror-content > * { margin-top:0; margin-bottom:1em; }
.firefly-prosemirror-content p { margin:.8em 0; }
.firefly-prosemirror-content h1,
.firefly-prosemirror-content h2,
.firefly-prosemirror-content h3,
.firefly-prosemirror-content h4 {
  color:#26382b;
  line-height:1.42;
  margin:1.45em 0 .62em;
  font-weight:760;
  letter-spacing:.005em;
  overflow-wrap:anywhere;
}
.firefly-prosemirror-content h1 {
  font-size:1.9em;
  margin-top:.45em;
  padding-bottom:.35em;
  border-bottom:1px solid #e5ece6;
}
.firefly-prosemirror-content h2 {
  font-size:1.55em;
  padding-bottom:.22em;
  border-bottom:1px solid #edf1ed;
}
.firefly-prosemirror-content h3 { font-size:1.28em; }
.firefly-prosemirror-content h4 { font-size:1.1em; }
.firefly-prosemirror-content ul,
.firefly-prosemirror-content ol { padding-left:1.7em; margin:.75em 0; }
.firefly-prosemirror-content li { padding-left:.15em; margin:.28em 0; }
.firefly-prosemirror-content li > p { margin:.25em 0; }
.firefly-prosemirror-content blockquote {
  border-left:3px solid #8fcaa0;
  margin:1.1em 0;
  padding:.6em 1em;
  color:#526257;
  background:#f6faf6;
  border-radius:0 8px 8px 0;
}
.firefly-prosemirror-content hr { border:0; border-top:1px solid #dfe8e0; margin:1.6em 0; }
.firefly-prosemirror-content pre {
  padding:14px 16px;
  border:1px solid #e3ebe4;
  border-radius:10px;
  background:#f5f8f5;
  overflow:auto;
  font:var(--firefly-reading-code-size,13px)/1.75 ui-monospace,SFMono-Regular,monospace;
  tab-size:2;
}
.firefly-prosemirror-content code {
  border:1px solid #e8eee9;
  border-radius:5px;
  background:#f4f7f4;
  padding:2px 5px;
  font:.9em ui-monospace,SFMono-Regular,monospace;
  overflow-wrap:anywhere;
}
.firefly-prosemirror-content pre code { padding:0; border:0; background:transparent; overflow-wrap:normal; }
.firefly-prosemirror-content .tableWrapper { max-width:100%; overflow-x:auto; margin:1.2em 0; border-radius:8px; }
.firefly-prosemirror-content table {
  width:100%;
  min-width:420px;
  border-collapse:collapse;
  table-layout:fixed;
}
.firefly-prosemirror-content th,
.firefly-prosemirror-content td {
  min-width:90px;
  border:1px solid #d8e1d8;
  padding:9px 11px;
  vertical-align:top;
  overflow-wrap:anywhere;
}
.firefly-prosemirror-content th { background:#f1f7f2; font-weight:700; }
.firefly-prosemirror-content a { color:#087c43; text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:3px; }
.firefly-prosemirror-content a:hover { color:#075e35; }
.firefly-prosemirror-content img {
  display:block;
  max-width:100%;
  max-height:520px;
  height:auto;
  object-fit:contain;
  margin:1.1em auto;
  border-radius:9px;
  background:#f6f8f6;
  cursor:zoom-in;
  transition:box-shadow .15s ease,outline-color .15s ease;
}
.firefly-prosemirror-content img:hover { box-shadow:0 0 0 3px #16834c33; }
.rich-editor-toolbar { position:relative; }
.rich-editor-toolbar button:focus-visible,
.table-editor-tools button:focus-visible {
  outline:2px solid #16834c;
  outline-offset:2px;
}
.rich-editor-help {
  padding:10px 13px;
  color:#657568;
  background:#f8fbf8;
  border-top:1px solid #e6eee7;
  font-size:12px;
  line-height:1.75;
}
.rich-editor-notice { margin:9px 0; border:1px solid #f0d5a5; border-radius:9px; background:#fffbeb; color:#874d0e; padding:10px 12px; font-size:12px; line-height:1.75; overflow-wrap:anywhere; }
.rich-editor-notice[hidden] { display:none!important; }
#wysiwygFallback { margin-top:8px; color:#b42318; font-size:12px; line-height:1.7; }
#markdownPreview[hidden],#wysiwygPane[hidden],#body[hidden] { display:none!important; }
.markdown-preview {
  min-height:240px;
  max-width:880px;
  margin-inline:auto;
  padding:clamp(16px,2.5vw,28px);
  border:1px solid #d8e1d8;
  border-radius:10px;
  background:#fff;
  color:#28352c;
  font-size:var(--firefly-reading-size,16px);
  line-height:1.92;
  overflow-wrap:anywhere;
}
.markdown-preview > :first-child { margin-top:0; }
.markdown-preview > :last-child { margin-bottom:0; }
.markdown-preview h1,
.markdown-preview h2,
.markdown-preview h3,
.markdown-preview h4 {
  color:#26382b;
  line-height:1.42;
  margin:1.45em 0 .62em;
  font-weight:760;
  letter-spacing:.005em;
  overflow-wrap:anywhere;
}
.markdown-preview h1 { font-size:1.9em; margin-top:.45em; padding-bottom:.35em; border-bottom:1px solid #e5ece6; }
.markdown-preview h2 { font-size:1.55em; padding-bottom:.22em; border-bottom:1px solid #edf1ed; }
.markdown-preview h3 { font-size:1.28em; }
.markdown-preview h4 { font-size:1.1em; }
.markdown-preview p { margin:.82em 0; }
.markdown-preview ul,.markdown-preview ol { padding-left:1.7em; margin:.75em 0; }
.markdown-preview li { margin:.28em 0; }
.markdown-preview blockquote { border-left:3px solid #8fcaa0; margin:1.1em 0; padding:.6em 1em; color:#526257; background:#f6faf6; border-radius:0 8px 8px 0; }
.markdown-preview hr { border:0; border-top:1px solid #dfe8e0; margin:1.6em 0; }
.markdown-preview pre { overflow:auto; background:#f5f8f5; border:1px solid #e3ebe4; padding:14px 16px; border-radius:10px; font:var(--firefly-reading-code-size,13px)/1.75 ui-monospace,SFMono-Regular,monospace; tab-size:2; }
.markdown-preview code { font:.9em ui-monospace,SFMono-Regular,monospace; background:#f1f5f2; border:1px solid #e8eee9; padding:2px 5px; border-radius:5px; overflow-wrap:anywhere; }
.markdown-preview pre code { padding:0; border:0; background:transparent; overflow-wrap:normal; }
.markdown-preview img { display:block; max-width:100%; max-height:520px; height:auto; object-fit:contain; margin:1.1em auto; border-radius:9px; background:#f6f8f6; cursor:zoom-in; }
.markdown-preview table { border-collapse:collapse; min-width:420px; width:100%; max-width:100%; display:block; overflow:auto; margin:1.2em 0; }
.markdown-preview th,.markdown-preview td { border:1px solid #d8e1d8; padding:9px 11px; text-align:left; vertical-align:top; }
.markdown-preview th { background:#f1f7f2; font-weight:700; }
.markdown-preview a { color:#087c43; text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:3px; }
.markdown-preview a:hover { color:#075e35; }
.field #body:not([hidden]) {
  min-height:360px;
  padding:14px 16px;
  border-color:#cbd9ce;
  background:#fbfdfb;
  color:#28352c;
  font:var(--firefly-reading-source-size,14px)/1.85 ui-monospace,SFMono-Regular,monospace;
  tab-size:2;
  overflow-wrap:normal;
  white-space:pre;
}
.field #body:not([hidden]):focus {
  outline:2px solid #16834c33;
  border-color:#70b787;
}
@media(max-width:720px) {
 .rich-editor-canvas { min-height:280px; max-height:none; padding:10px; scroll-behavior:auto; }
 .firefly-prosemirror-content { min-height:250px; max-width:100%; font-size:var(--firefly-reading-size,16px); line-height:1.9; }
 .firefly-prosemirror-content h1,.markdown-preview h1 { font-size:1.65em; }
 .firefly-prosemirror-content h2,.markdown-preview h2 { font-size:1.4em; }
 .firefly-prosemirror-content img,.markdown-preview img { max-height:360px; }
 .rich-editor-toolbar { gap:5px; padding:7px; }
 .rich-editor-toolbar button { min-height:42px; min-width:42px; padding:6px 8px; }
 .rich-editor-help { font-size:12px; }
 .markdown-preview { padding:16px; font-size:var(--firefly-reading-size,16px); }
 .field #body:not([hidden]) { min-height:300px; padding:12px; font-size:var(--firefly-reading-source-size,14px); }
}
@media(prefers-reduced-motion:reduce) {
 .rich-editor-canvas { scroll-behavior:auto; }
 .firefly-prosemirror-content img { transition:none; }
}


.editor-reading-controls {
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:7px;
  margin:0 0 9px;
  padding:8px 10px;
  border:1px solid #e1e9e2;
