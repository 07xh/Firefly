let aiDraftResult = null;
function setAiStatus(message, isError = false) {
  const status = $("aiStatus");
  status.hidden = false;
  status.textContent = message;
  status.style.color = isError ? "#b42318" : "#657267";
}
function setAiBusy(busy) {
  $("aiGenerate").disabled = busy;
  $("aiRewrite").disabled = busy;
  $("aiApply").disabled = busy;
  $("aiGenerate").textContent = busy ? "正在处理…" : "生成新文章草稿";
  $("aiRewrite").textContent = busy ? "正在处理…" : "按指令修改当前文章";
}
async function requestAiDraft(mode) {
  const prompt = $("aiPrompt").value.trim();
  if (!prompt) {
    setAiStatus("请先用中文写下文章要求或修改指令。", true);
    $("aiPrompt").focus();
    return;
  }
  let currentBody = "";
  if (mode === "rewrite") {
    showEditorTab();
    currentBody = $("body").value.replace(/^---\r?\n[\s\S]*?\r?\n---(?:\r?\n|$)/, "").trim();
    if (!currentBody) {
      setAiStatus("当前正文为空。请先选择一篇文章或填写正文，再使用修改功能。", true);
      return;
    }
  }
  const existing = {
    title: $("title").value.trim(),
    slug: $("slug").value.trim(),
    description: $("description").value.trim(),
    category: $("category").value.trim(),
    tags: $("tags").value.split(",").map(tag => tag.trim()).filter(Boolean)
  };
  const sourceSnapshot = mode === "rewrite" ? currentArticleSnapshot() : "";
  const targetPath = mode === "rewrite" ? (selected?.path || null) : null;
  setAiBusy(true);
  $("aiResult").hidden = true;
  setAiStatus(mode === "generate" ? "正在生成草稿，这不会保存或发布文章…" : "正在按要求修改正文，这不会保存或发布文章…");
  try {
    const response = await fetch("/api/admin/ai-draft/", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ mode, prompt, existing: mode === "generate" ? {} : existing, body: currentBody })
    });
    if (response.status === 401) {
      goLogin();
      return;
    }
    const data = await response.json().catch(() => ({ error: "AI 接口返回的响应无法解析。" }));
    if (!response.ok) throw new Error(data.error || "AI 写作没有完成，请稍后重试。");
    if (!data.draft || typeof data.draft.body !== "string") throw new Error("AI 返回结果缺少正文，请调整要求后重试。");
    aiDraftResult = { ...data.draft, mode, sourceSnapshot, targetPath };
    $("aiResultTitle").textContent = aiDraftResult.title || existing.title || "正文修改稿";
    const meta = [];
    if (aiDraftResult.category) meta.push("分类：" + aiDraftResult.category);
    if (Array.isArray(aiDraftResult.tags) && aiDraftResult.tags.length) meta.push("标签：" + aiDraftResult.tags.join("、"));
    if (aiDraftResult.slug) meta.push("文件名：" + aiDraftResult.slug);
    $("aiResultMeta").textContent = meta.join(" · ");
    const preview = aiDraftResult.body;
    $("aiResultBody").textContent = preview.length > 5000 ? preview.slice(0, 5000) + "\n\n（这里只显示前 5000 个字符；填入后可查看完整预览。）" : preview;
    $("aiResult").hidden = false;
    setAiStatus("草稿已生成。请先检查内容，再选择是否填入编辑器。");
  } catch (error) {
    setAiStatus(error instanceof Error ? error.message : "AI 写作请求失败，请检查网络或 Worker 配置。", true);
  } finally {
    setAiBusy(false);
  }
}
$("aiGenerate").onclick = () => requestAiDraft("generate");
$("aiRewrite").onclick = () => requestAiDraft("rewrite");
$("aiDiscard").onclick = () => {
