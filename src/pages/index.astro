---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import { url } from "@/utils/url-utils";

export const prerender = true;
const firstProject = url("/projects/dorm-os/");
---

<PortfolioLayout title="07xh Space">
	<portfolio-home data-next-project={siteConfig.pages.projects ? firstProject : undefined}>
		<section class="portfolio-home-intro" aria-labelledby="home-title">
			<div>
				<h1 id="home-title">07xh Space</h1>
				<p class="portfolio-home-lead">小慌的软件项目和学习笔记。</p>
				<div class="portfolio-actions">
					{siteConfig.pages.projects && <a class="portfolio-button portfolio-button-solid" href={firstProject}>看校序 <Icon name="material-symbols:arrow-forward-rounded" /></a>}
					<a class="portfolio-button portfolio-button-secondary" href={url("/posts/")}>博客</a>
				</div>
			</div>
		</section>
	</portfolio-home>
</PortfolioLayout>

<script>
	class PortfolioHome extends HTMLElement {
		private point: { id: number; x: number; y: number } | null = null;
		private wheelDistance = 0;
		private wheelTime = 0;
		private navigating = false;
		private readonly interactive = "a,button,input,textarea,select,summary,[contenteditable],[role=dialog],pre,table";

		connectedCallback() {
			this.addEventListener("pointerdown", this.start);
			this.addEventListener("pointerup", this.end);
			this.addEventListener("pointercancel", this.cancel);
			this.addEventListener("wheel", this.onWheel, { passive: false });
			document.addEventListener("keydown", this.onKey);
			window.addEventListener("pageshow", this.reset);
		}
		disconnectedCallback() {
			this.removeEventListener("pointerdown", this.start);
			this.removeEventListener("pointerup", this.end);
			this.removeEventListener("pointercancel", this.cancel);
			this.removeEventListener("wheel", this.onWheel);
			document.removeEventListener("keydown", this.onKey);
			window.removeEventListener("pageshow", this.reset);
		}
		private readonly canMove = (event: Event) =>
			!(event.target instanceof Element && event.target.closest(this.interactive));
		private readonly move = () => {
			const target = this.dataset.nextProject;
			if (!target || this.navigating) return false;
			this.navigating = true;
			window.location.assign(target);
			return true;
		};
		private readonly start = (event: PointerEvent) => {
			if (!event.isPrimary || event.pointerType === "mouse" || !this.canMove(event)) return;
			this.point = { id: event.pointerId, x: event.clientX, y: event.clientY };
		};
		private readonly end = (event: PointerEvent) => {
			const start = this.point;
			this.point = null;
			if (!start || start.id !== event.pointerId) return;
			const dx = event.clientX - start.x;
			const dy = event.clientY - start.y;
			if (dx < -70 && Math.abs(dx) > Math.abs(dy) * 1.6) this.move();
		};
		private readonly cancel = () => { this.point = null; };
		private readonly reset = () => { this.navigating = false; this.wheelDistance = 0; };
		private readonly onWheel = (event: WheelEvent) => {
			if (event.ctrlKey || !this.canMove(event) || event.deltaX <= 0 || Math.abs(event.deltaX) < Math.abs(event.deltaY) * 1.6) return;
			if (event.timeStamp - this.wheelTime > 180 || this.wheelDistance < 0) this.wheelDistance = 0;
			this.wheelTime = event.timeStamp;
			this.wheelDistance += event.deltaX * (event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : 1);
			if (this.wheelDistance > 90 && this.move()) event.preventDefault();
		};
		private readonly onKey = (event: KeyboardEvent) => {
			if (event.key !== "ArrowRight" || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || !this.canMove(event) || window.getSelection()?.toString()) return;
			if (this.move()) event.preventDefault();
		};
	}
	if (!customElements.get("portfolio-home")) customElements.define("portfolio-home", PortfolioHome);
</script>
