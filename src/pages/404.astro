---
import { Icon } from "astro-icon/components";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import "@/styles/space-utility.css";
import { url } from "@/utils/url-utils";
---

<PortfolioLayout title="页面不存在" description="没有找到这个页面，可以返回首页或继续浏览。">
	<section class="space-utility-page space-not-found" aria-labelledby="missing-title">
		<div class="space-not-found-visual" aria-hidden="true">
			<img src={url("/brand/07xh-ship-refined.svg")} alt="" width="196" height="196" />
			<span>404</span>
		</div>
		<h1 id="missing-title">这条路线暂时没找到</h1>
		<p>链接可能已经调整。你可以从项目、文章或搜索重新出发。</p>
		<nav class="space-not-found-actions" aria-label="继续浏览">
			<a href={url("/")} class="space-utility-primary-link">
				<Icon name="material-symbols:home-rounded" aria-hidden="true" />
				返回首页
			</a>
			<a href={url("/posts/")} class="space-utility-secondary-link">浏览文章</a>
			<a href={url("/search/")} class="space-utility-secondary-link">站内搜索</a>
		</nav>
	</section>
</PortfolioLayout>
