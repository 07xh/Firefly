---
import { Icon } from "astro-icon/components";
import PublicRepositories from "@/components/portfolio/PublicRepositories.astro";
import { siteConfig } from "@/config";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import { getSortedProjects } from "@/utils/content-utils";
import { getProjectStatusMeta } from "@/utils/projects-utils";
import { removeFileExtension, url } from "@/utils/url-utils";

export const prerender = true;

if (!siteConfig.pages.projects) return Astro.redirect(url("/404/"));

const projects = (await getSortedProjects()).filter(
	({ id }) => !["example-project", "firefly"].includes(removeFileExtension(id)),
);
const statuses = [
	...new Set(projects.map(({ data }) => data.status).filter(Boolean)),
];
---

<PortfolioLayout title="项目" description="小慌的软件项目与公开仓库。">
	<header class="portfolio-page-intro">
		<h1>项目</h1>
	</header>
	<portfolio-project-list>
		<div class="portfolio-project-filters">
			<div role="group" aria-label="按项目状态筛选">
				<button type="button" data-filter="" aria-pressed="true">全部</button>
				{statuses.map((status) => (
					<button type="button" data-filter={status} aria-pressed="false">{getProjectStatusMeta(status).label}</button>
				))}
			</div>
			<label><span class="sr-only">搜索项目</span><input type="search" placeholder="搜索项目" /></label>
		</div>
		<ul class="portfolio-project-grid">
			{projects.map((project) => {
				const { title, description, status, tags, repository } = project.data;
				const id = removeFileExtension(project.id);
				return (
					<li data-repository={repository.toLowerCase().startsWith("07xh/") ? repository.slice(5).toLowerCase() : ""} data-status={status} data-project-search={[title, description, repository, ...tags].join(" ").toLowerCase()}>
						<a class="portfolio-project-card" href={url(`/projects/${id}/`)}>
							<div class="portfolio-project-card-copy">
								<h2>{title}</h2>
								<p>{description}</p>
							</div>
							<div class="portfolio-project-card-meta">
								{status && <span>{getProjectStatusMeta(status).label}</span>}
								<Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
							</div>
						</a>
					</li>
				);
			})}
		</ul>
		<p class="portfolio-empty" data-empty role="status" hidden={projects.length > 0}>没有符合条件的项目。</p>
		<PublicRepositories featured={projects.flatMap(({ data }) => data.repository.toLowerCase().startsWith("07xh/") ? [data.repository.slice(5).toLowerCase()] : [])} />
	</portfolio-project-list>
</PortfolioLayout>

<script>
	class PortfolioProjectList extends HTMLElement {
		private status = "";
		private publicNames: Set<string> | null = null;

		connectedCallback() {
			this.addEventListener("input", this.filter);
			this.addEventListener("click", this.select);
			this.addEventListener("portfolio-repositories", this.onRepositories);
		}

		disconnectedCallback() {
			this.removeEventListener("input", this.filter);
			this.removeEventListener("click", this.select);
			this.removeEventListener("portfolio-repositories", this.onRepositories);
		}

		private onRepositories = (event: Event) => {
			if (!(event instanceof CustomEvent)) return;
			this.publicNames = event.detail;
			this.filter();
		};

		private select = (event: MouseEvent) => {
			if (!(event.target instanceof Element)) return;
			const button = event.target.closest<HTMLButtonElement>("[data-filter]");
			if (!button) return;
			this.status = button.dataset.filter ?? "";
			this.querySelectorAll("[data-filter]").forEach((item) => {
				item.setAttribute("aria-pressed", String(item === button));
			});
			this.filter();
		};

		private filter = () => {
			const query = this.querySelector<HTMLInputElement>(".portfolio-project-filters input")?.value.trim().toLowerCase() ?? "";
			let hasResults = false;
			this.querySelectorAll<HTMLElement>("[data-project-search]").forEach((item) => {
				const repository = item.dataset.repository;
				const listed = !repository || !this.publicNames || this.publicNames.has(repository);
				const matches = listed && (!this.status || item.dataset.status === this.status)
					&& (item.dataset.projectSearch?.includes(query) ?? false);
				item.hidden = !matches;
				hasResults ||= matches;
			});
			this.querySelector("[data-empty]")?.toggleAttribute("hidden", hasResults);
		};
	}

	if (!customElements.get("portfolio-project-list")) customElements.define("portfolio-project-list", PortfolioProjectList);
</script>
