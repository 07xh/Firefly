---
import { Icon } from "astro-icon/components";
import ProjectVisual from "@/components/portfolio/ProjectVisual.astro";
import { siteConfig } from "@/config";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import { getSortedProjects } from "@/utils/content-utils";
import { getProjectStatusMeta } from "@/utils/projects-utils";
import { removeFileExtension, url } from "@/utils/url-utils";

export const prerender = true;

if (!siteConfig.pages.projects) return Astro.redirect(url("/404/"));

const projects = (await getSortedProjects()).filter(({ id }) => removeFileExtension(id) !== "example-project");
const statuses = [...new Set(projects.map(({ data }) => data.status).filter(Boolean))];
---

<PortfolioLayout title="项目作品" description="小慌的个人软件作品、实现说明与 GitHub 仓库。">
	<header class="portfolio-page-intro">
		<h1>项目作品</h1>
		<p>校园工具、桌面应用与 Android 实验。打开任一项目查看实现、当前状态和源码。</p>
	</header>
	<portfolio-project-list>
		<div class="portfolio-project-filters">
			<div role="group" aria-label="按项目状态筛选">
				<button type="button" data-filter="" aria-pressed="true">全部</button>
				{statuses.map((status) => (
					<button type="button" data-filter={status} aria-pressed="false">{getProjectStatusMeta(status).label}</button>
				))}
			</div>
			<label><span class="sr-only">搜索项目</span><input type="search" placeholder="搜索项目" /></label>
		</div>
		<ul class="portfolio-project-grid">
			{projects.map((project) => {
				const { title, description, status, tags, repository } = project.data;
				const id = removeFileExtension(project.id);
				return (
					<li data-status={status} data-project-search={[title, description, repository, ...tags].join(" ").toLowerCase()}>
						<a class="portfolio-project-card" href={url(`/projects/${id}/`)}>
							<ProjectVisual project={project} />
							<div class="portfolio-project-card-copy">
								<p class="portfolio-label">{status && getProjectStatusMeta(status).label}</p>
								<h2>{title}</h2>
								<p>{description}</p>
								<div class="portfolio-project-card-footer">
									<span>{tags.slice(0, 3).join(" · ")}</span><Icon name="material-symbols:arrow-outward-rounded" />
								</div>
							</div>
						</a>
					</li>
				);
			})}
		</ul>
		<p class="portfolio-empty" data-empty role="status" hidden={projects.length > 0}>没有符合条件的项目。</p>
	</portfolio-project-list>
</PortfolioLayout>

<script>
	class PortfolioProjectList extends HTMLElement {
		private status = "";

		connectedCallback() {
			this.addEventListener("input", this.filter);
			this.addEventListener("click", this.select);
		}

		disconnectedCallback() {
			this.removeEventListener("input", this.filter);
			this.removeEventListener("click", this.select);
		}

		private select = (event: MouseEvent) => {
			if (!(event.target instanceof Element)) return;
			const button = event.target.closest<HTMLButtonElement>("[data-filter]");
			if (!button) return;
			this.status = button.dataset.filter ?? "";
			this.querySelectorAll("[data-filter]").forEach((item) => {
				item.setAttribute("aria-pressed", String(item === button));
			});
			this.filter();
		};

		private filter = () => {
			const query = this.querySelector("input")?.value.trim().toLowerCase() ?? "";
			let hasResults = false;
			this.querySelectorAll<HTMLElement>("[data-project-search]").forEach((item) => {
				const matches = (!this.status || item.dataset.status === this.status)
					&& (item.dataset.projectSearch?.includes(query) ?? false);
				item.hidden = !matches;
				hasResults ||= matches;
			});
			this.querySelector("[data-empty]")?.toggleAttribute("hidden", hasResults);
		};
	}

	if (!customElements.get("portfolio-project-list")) customElements.define("portfolio-project-list", PortfolioProjectList);
</script>
