---
import ProjectShowcase from "@/components/portfolio/ProjectShowcase.astro";
import { siteConfig } from "@/config";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import { getPortfolioScenes } from "@/utils/portfolio-scenes";
import { resolveProjectImageAbsolute } from "@/utils/projects-utils";
import { url } from "@/utils/url-utils";

export const prerender = true;

export async function getStaticPaths() {
	const scenes = await getPortfolioScenes();
	return scenes.map(({ slug, ...props }) => ({
		params: { slug },
		props,
	}));
}

if (!siteConfig.pages.projects) return Astro.redirect(url("/404/"));

const { entry, previous, next, position, total } = Astro.props;
const cover = await resolveProjectImageAbsolute(entry.data.image, entry.filePath);
---

<PortfolioLayout title={entry.data.title} description={entry.data.description || entry.data.title} lang={entry.data.lang || undefined} setOGTypeArticle={true} postCoverImage={cover}>
	<ProjectShowcase entry={entry} previous={previous} next={next} position={position} total={total} />
</PortfolioLayout>
