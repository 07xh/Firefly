---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import ProjectVisual from "@/components/portfolio/ProjectVisual.astro";
import { siteConfig } from "@/config";
import githubData from "@/constants/github-card-data.json";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import { getSortedProjects } from "@/utils/content-utils";
import { getProjectStatusMeta, resolveProjectImage, resolveProjectImageAbsolute } from "@/utils/projects-utils";
import { removeFileExtension, url } from "@/utils/url-utils";

export const prerender = true;

export async function getStaticPaths() {
	const projects = await getSortedProjects();
	return projects.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

if (!siteConfig.pages.projects) return Astro.redirect(url("/404/"));

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, subtitle, description, tags, status, link, repository } = entry.data;
const cover = await resolveProjectImageAbsolute(entry.data.image, entry.filePath);
const zoomImage = await resolveProjectImage(entry.data.image, entry.filePath);
interface RepositoryMetadata {
	language?: string | null;
	license?: string | null;
	stars?: number;
	pushedAt?: string;
	checkedAt?: string;
	release?: { tag: string; url: string; prerelease: boolean } | null;
}
const github = (githubData as Record<string, RepositoryMetadata>)[repository.toLowerCase()];
const sections = headings.filter(({ depth }) => depth === 2);
---

<PortfolioLayout title={title} description={description || title} lang={entry.data.lang || undefined} setOGTypeArticle={true} postCoverImage={cover}>
	<a class="portfolio-back" href={url("/projects/")}><Icon name="material-symbols:arrow-back-rounded" /> 项目作品</a>
	<header class="portfolio-detail-hero">
		<div class="portfolio-detail-heading">
			{status && <p class="portfolio-label">{getProjectStatusMeta(status).label}</p>}
			<h1 data-pagefind-meta="title">{title}</h1>
			{subtitle && <p class="portfolio-detail-subtitle">{subtitle}</p>}
			<p>{description}</p>
			{link.length > 0 && (
				<div class="portfolio-actions">
					{link.map(({ label, value }, index) => (
						<a href={value} class:list={["portfolio-button", index === 0 ? "portfolio-button-solid" : "portfolio-button-secondary"]}>
							{label === "GitHub" && <Icon name="fa7-brands:github" />}
							{label} <Icon name="material-symbols:arrow-outward-rounded" />
						</a>
					))}
				</div>
			)}
		</div>
		<ProjectVisual project={entry} priority />
	</header>
	{(sections.length > 0 || repository) && (
		<nav class="portfolio-detail-nav" aria-label="项目页章节">
			{sections.map(({ slug, text }) => <a href={`#${slug}`}>{text}</a>)}
			{repository && <a href="#project-repository">仓库与版本</a>}
			{zoomImage && <a href={zoomImage} data-fancybox="project-cover" data-type="image">查看大图</a>}
		</nav>
	)}
	<div class="portfolio-detail-body">
		<div data-pagefind-body>
			<Markdown class="markdown-content"><Content /></Markdown>
		</div>
		{(repository || tags.length > 0) && (
			<aside class="portfolio-repo" id="project-repository">
				<h2>{repository ? "仓库与版本" : "技术栈"}</h2>
				{repository && <a class="portfolio-text-link" href={`https://github.com/${repository}`}>{repository} <Icon name="material-symbols:arrow-outward-rounded" /></a>}
				{tags.length > 0 && <ul class="portfolio-tags" aria-label="技术栈">{tags.map((tag) => <li>{tag}</li>)}</ul>}
				{github && (
					<dl>
						{github.language && <div><dt>主要语言</dt><dd>{github.language}</dd></div>}
						{github.license && github.license !== "NOASSERTION" && <div><dt>许可证</dt><dd>{github.license}</dd></div>}
						{github.stars !== undefined && <div><dt>Stars</dt><dd>{github.stars.toLocaleString("zh-CN")}</dd></div>}
						{github.pushedAt && <div><dt>最近推送</dt><dd><time datetime={github.pushedAt}>{github.pushedAt.slice(0, 10)}</time></dd></div>}
						{github.release && <div><dt>{github.release.prerelease ? "预发布" : "最近发布"}</dt><dd><a href={github.release.url}>{github.release.tag} <Icon name="material-symbols:arrow-outward-rounded" /></a></dd></div>}
					</dl>
				)}
				{github?.checkedAt && <p class="portfolio-sync">仓库数据同步于 <time datetime={github.checkedAt}>{github.checkedAt.slice(0, 10)}</time></p>}
			</aside>
		)}
	</div>
</PortfolioLayout>
